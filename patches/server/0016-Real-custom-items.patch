+package me.sosedik.kiterino.util;
+
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+public class KiterinoDataInjectorRuntimeException extends RuntimeException {
+
+	public KiterinoDataInjectorRuntimeException(@NotNull String message) {
+		super(message);
+	}
+
+	public KiterinoDataInjectorRuntimeException(@NotNull String message, @Nullable Throwable cause) {
+		super(message, cause);
+	}
+
+}
