From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Sat, 22 Jun 2024 21:32:29 +0300
Subject: [PATCH] Keep rider when teleporting


diff --git a/src/main/java/net/minecraft/world/entity/Entity.java b/src/main/java/net/minecraft/world/entity/Entity.java
index 3322add5b8d165254f1fca8e0998a6dadd7623f7..15bba1fd46f75f7c1ac1d0ad826c331e8b2631a8 100644
--- a/src/main/java/net/minecraft/world/entity/Entity.java
+++ b/src/main/java/net/minecraft/world/entity/Entity.java
@@ -4917,7 +4917,7 @@ public abstract class Entity implements SyncedDataHolder, Nameable, EntityAccess
     // Paper end - Expose entity id counter
     // Purpur start
     @Nullable
-    private Player rider = null;
+    public Player rider = null; // Kiterino - Keep rider when teleporting
 
     @Nullable
     public Player getRider() {
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index eff978d8f6c5075b73a077001c85152300285b6c..da22e8ed23b721f29270c03cbd207e83ee9c294c 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -248,11 +248,18 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
     // EMC start - vehicle passenger teleporting
     private static CraftEntity teleportingEntity;
     private CraftEntity storedRoot;
+    private CraftHumanEntity storedRider; // Kiterino - Keep rider when teleporting
     private com.google.common.collect.ImmutableList<CraftEntity> storedPassengers;
     void detachEntities() {
         if (teleportingEntity == null) {
             teleportingEntity = this;
             this.storedRoot = entity.getRootVehicle().getBukkitEntity();
+            // Kiterino start - Keep rider when teleporting
+            CraftEntity vehicle = (CraftEntity) getVehicle();
+            if (vehicle != null) {
+                this.storedRider = (CraftHumanEntity) vehicle.getRider();
+            }
+            // Kiterino end - Keep rider when teleporting
             this.storedRoot.detachEntities();
             teleportingEntity = null;
             return;
@@ -276,6 +283,15 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
                 teleportingEntity = this;
                 this.storedRoot.teleportAndReattachEntities(location);
                 this.storedRoot.reattachPassengers();
+                // Kiterino start - Keep rider when teleporting
+                if (this.storedRider != null) {
+                    CraftEntity vehicle = (CraftEntity) getVehicle();
+                    if (vehicle != null) {
+                        vehicle.getHandle().rider = this.storedRider.getHandle();
+                    }
+                    this.storedRider = null;
+                }
+                // Kiterino end - Keep rider when teleporting
                 this.storedRoot = null;
                 teleportingEntity = null;
             }
