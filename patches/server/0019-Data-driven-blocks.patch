index 0000000000000000000000000000000000000000..46f1582e9a0b774c9ce9c9e781f4c480461c490b
--- /dev/null
+++ b/src/main/java/me/sosedik/kiterino/world/block/KiterinoBlockStateIdMapper.java
@@ -0,0 +1,27 @@
+package me.sosedik.kiterino.world.block;
+
+import net.minecraft.core.IdMapper;
+import net.minecraft.world.level.block.state.BlockState;
+import org.bukkit.craftbukkit.block.CraftBlockState;
+import org.jspecify.annotations.NullMarked;
+
+@NullMarked
+public class KiterinoBlockStateIdMapper extends IdMapper<BlockState> {
+
+	public static int lastVanillaBlockStateId = 0;
+
+	public KiterinoBlockStateIdMapper() {
+		super();
+	}
+
+	@Override
+	public int getId(BlockState value) {
+		if (!(value.getBlock() instanceof KiterinoBlock kiterinoBlock)) {
+			return super.getId(value);
+		}
+
+		org.bukkit.block.BlockState bukkitState = kiterinoBlock.serializeBlockToClient();
+		return bukkitState == null ? super.getId(value) : super.getId(((CraftBlockState) bukkitState).getHandle());
+	}
+
+}
