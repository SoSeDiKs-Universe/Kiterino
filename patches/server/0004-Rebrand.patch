+                    log.log(Level.SEVERE, "--- DO NOT REPORT THIS TO KITERINO - THIS IS NOT A BUG OR A CRASH ---"); // Kiterino - Rebrand
                 }
 
                 log.log( Level.SEVERE, "------------------------------" );
