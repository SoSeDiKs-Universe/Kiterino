From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Fri, 20 Sep 2024 22:48:30 +0300
Subject: [PATCH] Add predicate support for recipe book

Allows using Purpur's ingredient predicate as a matcher for the recipe book.

Implementation details:
- Purpur's predicates do not check the item type, it's up to the developer.
- Vanilla limitations still apply: no damaged/enchanted/renamed items.

diff --git a/src/main/java/io/papermc/paper/inventory/recipe/ItemOrExact.java b/src/main/java/io/papermc/paper/inventory/recipe/ItemOrExact.java
index caaad8f54fb892dfd6c7d4e02ab9c32997f89a6a..2b733cb72c8359da13115ec78379aa44fb6f72c6 100644
--- a/src/main/java/io/papermc/paper/inventory/recipe/ItemOrExact.java
+++ b/src/main/java/io/papermc/paper/inventory/recipe/ItemOrExact.java
@@ -3,7 +3,7 @@ package io.papermc.paper.inventory.recipe;
 import net.minecraft.core.Holder;
 import net.minecraft.world.item.ItemStack;
 
-public sealed interface ItemOrExact permits ItemOrExact.Item, ItemOrExact.Exact {
+public sealed interface ItemOrExact permits ItemOrExact.Item, ItemOrExact.Exact, ItemOrExact.Predicate { // Kiterino - Add predicate support for recipe book
 
     int getMaxStackSize();
 
@@ -60,4 +60,30 @@ public sealed interface ItemOrExact permits ItemOrExact.Item, ItemOrExact.Exact
             return ItemStack.hashItemAndComponents(this.stack);
         }
     }
+
+    // Kiterino start - Add predicate support for recipe book
+    record Predicate(ItemStack stack, java.util.function.Predicate<ItemStack> predicate) implements ItemOrExact {
+
+        @Override
+        public int getMaxStackSize() {
+            return this.stack.getMaxStackSize();
+        }
+
+        @Override
+        public boolean matches(final ItemStack stack) {
+            return this.predicate.test(stack);
+        }
+
+        @Override
+        public boolean equals(final Object obj) {
+            if (!(obj instanceof final Predicate other)) return false;
+            return ItemStack.isSameItemSameComponents(this.stack, other.stack) && java.util.Objects.equals(this.predicate, other.predicate);
+        }
+
+        @Override
+        public int hashCode() {
+            return ItemStack.hashItemAndComponents(this.stack);
+        }
+    }
+    // Kiterino end - Add predicate support for recipe book
 }
diff --git a/src/main/java/io/papermc/paper/inventory/recipe/StackedContentsExtrasMap.java b/src/main/java/io/papermc/paper/inventory/recipe/StackedContentsExtrasMap.java
index bdb876a0e687d4b9e885118523e91185a164b27c..74be86cd3536fc43266b45f446de78bdf840a048 100644
--- a/src/main/java/io/papermc/paper/inventory/recipe/StackedContentsExtrasMap.java
+++ b/src/main/java/io/papermc/paper/inventory/recipe/StackedContentsExtrasMap.java
@@ -15,6 +15,7 @@ public final class StackedContentsExtrasMap {
     private final StackedContents<ItemOrExact> contents;
     public Object2IntMap<ItemOrExact.Item> regularRemoved = new Object2IntOpenHashMap<>(); // needed for re-using the regular contents (for ShapelessRecipe)
     public final ObjectSet<ItemStack> exactIngredients = new ObjectOpenCustomHashSet<>(ItemStackLinkedSet.TYPE_AND_TAG);
+    public final java.util.Map<ItemStack, java.util.function.Predicate<ItemStack>> predicateIngredients = new java.util.HashMap<>(); // Kiterino - Add predicate support for recipe book
 
     public StackedContentsExtrasMap(final StackedContents<ItemOrExact> contents) {
         this.contents = contents;
@@ -24,7 +25,16 @@ public final class StackedContentsExtrasMap {
         this.exactIngredients.clear();
         for (final StackedContents.IngredientInfo<ItemOrExact> info : recipe.placementInfo().unpackedIngredients()) {
             if (info.isExact()) {
-                this.exactIngredients.addAll(info.allowedItems().stream().map(o -> ((ItemOrExact.Exact) o).stack()).toList());
+                // Kiterino start - Add predicate support for recipe book
+                // this.exactIngredients.addAll(info.allowedItems().stream().map(o -> ((ItemOrExact.Exact) o).stack()).toList());
+                info.allowedItems().forEach(o -> {
+                    if (o instanceof ItemOrExact.Predicate predicate) {
+                        this.predicateIngredients.put(predicate.stack(), predicate.predicate());
+                    } else {
+                        this.exactIngredients.add(((ItemOrExact.Exact) o).stack());
+                    }
+                });
+                // Kiterino end - Add predicate support for recipe book
             }
         }
     }
@@ -54,10 +64,18 @@ public final class StackedContentsExtrasMap {
             this.contents.amounts.addTo(entry.getKey(), entry.getIntValue());
         }
         this.exactIngredients.clear();
+        this.predicateIngredients.clear(); // Kiterino - Add predicate support for recipe book
         this.regularRemoved.clear();
     }
 
     public boolean accountStack(final ItemStack stack, final int count) {
+        // Kiterino start - Add predicate support for recipe book
+        java.util.function.Predicate<ItemStack> predicate = this.predicateIngredients.get(stack);
+        if (predicate != null) {
+            this.contents.account(new ItemOrExact.Predicate(stack, predicate), count);
+            return true;
+        }
+        // Kiterino end - Add predicate support for recipe book
         if (this.exactIngredients.contains(stack)) {
             this.contents.account(new ItemOrExact.Exact(stack), count);
             return true;
diff --git a/src/main/java/net/minecraft/world/item/crafting/Ingredient.java b/src/main/java/net/minecraft/world/item/crafting/Ingredient.java
index 10730b307971915f52b3e41068a864b8ee1352b4..af689e3165f96b223c3094056a94a18c21bf94ab 100644
--- a/src/main/java/net/minecraft/world/item/crafting/Ingredient.java
+++ b/src/main/java/net/minecraft/world/item/crafting/Ingredient.java
@@ -45,7 +45,7 @@ public final class Ingredient implements Predicate<ItemStack> {
     // CraftBukkit start
     @Nullable
     private List<ItemStack> itemStacks;
-    public Predicate<org.bukkit.inventory.ItemStack> predicate; // Purpur
+    public @Nullable Predicate<org.bukkit.inventory.ItemStack> predicate; // Purpur // Kiterino  - Mark nullable - Add predicate support for recipe book
 
     public boolean isExact() {
         return this.itemStacks != null;
diff --git a/src/main/java/net/minecraft/world/item/crafting/PlacementInfo.java b/src/main/java/net/minecraft/world/item/crafting/PlacementInfo.java
index 400fd1cdfd17d4d34552f9bb3d91bc71fd394301..dfd07f44d39fc5923d9d1ff331df85f29d5fd3ee 100644
--- a/src/main/java/net/minecraft/world/item/crafting/PlacementInfo.java
+++ b/src/main/java/net/minecraft/world/item/crafting/PlacementInfo.java
@@ -24,6 +24,11 @@ public class PlacementInfo {
 
     // Paper start - Improve exact choice recipe ingredients
     public static StackedContents.IngredientInfo<io.papermc.paper.inventory.recipe.ItemOrExact> ingredientToContents(Ingredient ingredient) {
+        // Kiterino start - Add predicate support for recipe book
+        if (ingredient.predicate != null) {
+            return StackedItemContents.convertIngredientContents(ingredient.itemStacks().stream().map(bukkitItem -> new io.papermc.paper.inventory.recipe.ItemOrExact.Predicate(bukkitItem, itemStack -> ingredient.predicate.test(itemStack.asBukkitMirror()))), true);
+        }
+        // Kiterino end - Add predicate support for recipe book
         return StackedItemContents.convertIngredientContents(ingredient.isExact() ? ingredient.itemStacks().stream().map(io.papermc.paper.inventory.recipe.ItemOrExact.Exact::new) : ingredient.items().stream().map(io.papermc.paper.inventory.recipe.ItemOrExact.Item::new), ingredient.isExact());
         // Paper end - Improve exact choice recipe ingredients
     }
