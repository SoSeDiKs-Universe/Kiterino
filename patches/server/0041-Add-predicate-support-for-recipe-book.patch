From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Fri, 20 Sep 2024 22:48:30 +0300
Subject: [PATCH] Add predicate support for recipe book

Allows using Purpur's ingredient predicate as a matcher for the recipe book.

Implementation details:
- Purpur's predicates do not check the item type, it's up to the developer.
- Vanilla limitations still apply: no damaged/enchanted/renamed items.

diff --git a/src/main/java/io/papermc/paper/inventory/recipe/StackedContentsExtraMap.java b/src/main/java/io/papermc/paper/inventory/recipe/StackedContentsExtraMap.java
index 568ba6aed2e74b8d84f4e82c1e785ef1587e2617..6fa7cd6ef08b7f84b493ca97ca39284c39f01e0e 100644
--- a/src/main/java/io/papermc/paper/inventory/recipe/StackedContentsExtraMap.java
+++ b/src/main/java/io/papermc/paper/inventory/recipe/StackedContentsExtraMap.java
@@ -26,6 +26,7 @@ public final class StackedContentsExtraMap {
     private final AtomicInteger idCounter = new AtomicInteger(BuiltInRegistries.ITEM.size()); // start at max vanilla stacked contents idx
     public final Object2IntMap<ItemStack> exactChoiceIds = new Object2IntOpenCustomHashMap<>(ItemStackLinkedSet.TYPE_AND_TAG);
     private final Int2ObjectMap<ItemStack> idToExactChoice = new Int2ObjectOpenHashMap<>();
+    public final Int2ObjectMap<java.util.function.Predicate<org.bukkit.inventory.ItemStack>> idToValidator = new Int2ObjectOpenHashMap<>(); // Kiterino - Add predicate support for recipe book
     private final StackedContents contents;
     public final Map<Ingredient, IntList> extraStackingIds = new IdentityHashMap<>();
 
@@ -50,6 +51,11 @@ public final class StackedContentsExtraMap {
                     }
                     idList.sort(IntComparators.NATURAL_COMPARATOR);
                     this.extraStackingIds.put(ingredient, idList);
+                    // Kiterino start - Add predicate support for recipe book
+                    for (int id : idList) {
+                        this.idToValidator.put(id, ingredient.predicate);
+                    }
+                    // Kiterino end - Add predicate support for recipe book
                 }
             }
         }
diff --git a/src/main/java/net/minecraft/recipebook/ServerPlaceRecipe.java b/src/main/java/net/minecraft/recipebook/ServerPlaceRecipe.java
index 6d1f9c15dc99917a2ac966ea38ef1970f4f0289c..ad35a00a392264e3a88c0c467f5bd574d43ef3d4 100644
--- a/src/main/java/net/minecraft/recipebook/ServerPlaceRecipe.java
+++ b/src/main/java/net/minecraft/recipebook/ServerPlaceRecipe.java
@@ -111,8 +111,9 @@ public class ServerPlaceRecipe<I extends RecipeInput, R extends Recipe<I>> imple
         if (!itemStack.isEmpty()) {
             int i = amount;
 
+            @Nullable java.util.function.Predicate<org.bukkit.inventory.ItemStack> validator = this.stackedContents.extrasMap == null ? null : this.stackedContents.extrasMap.idToValidator.get((int) input); // Kiterino - Add predicate support for recipe book
             while (i > 0) {
-                i = this.moveItemToGrid(slot2, itemStack, i, isExact); // Paper - Improve exact choice recipe ingredients
+                i = this.moveItemToGrid(slot2, itemStack, i, isExact, validator); // Paper - Improve exact choice recipe ingredients // Kiterino - Add predicate support for recipe book
                 if (i == -1) {
                     return;
                 }
@@ -148,10 +149,15 @@ public class ServerPlaceRecipe<I extends RecipeInput, R extends Recipe<I>> imple
 
     protected int moveItemToGrid(Slot slot, ItemStack stack, int i) {
         // Paper start - Improve exact choice recipe ingredients
+        // Kiterino start - Add predicate support for recipe book
         return this.moveItemToGrid(slot, stack, i, false);
     }
     protected int moveItemToGrid(Slot slot, ItemStack stack, int i, final boolean isExact) {
-        int j = isExact ? this.inventory.findSlotMatchingItem(stack) : this.inventory.findSlotMatchingUnusedItem(stack);
+        return this.moveItemToGrid(slot, stack, i, isExact, null);
+    }
+    protected int moveItemToGrid(Slot slot, ItemStack stack, int i, final boolean isExact, @Nullable java.util.function.Predicate<org.bukkit.inventory.ItemStack> validator) {
+        int j = isExact && validator == null ? this.inventory.findSlotMatchingItem(stack) : this.inventory.findSlotMatchingUnusedItem(stack, validator);
+        // Kiterino end - Add predicate support for recipe book
         // Paper end - Improve exact choice recipe ingredients
         if (j == -1) {
             return -1;
diff --git a/src/main/java/net/minecraft/world/entity/player/Inventory.java b/src/main/java/net/minecraft/world/entity/player/Inventory.java
index abf231e6099cda766d73e67f31234e9f4cbc9545..e7d925586f1197f50c499dc58b55cb8973d0fed1 100644
--- a/src/main/java/net/minecraft/world/entity/player/Inventory.java
+++ b/src/main/java/net/minecraft/world/entity/player/Inventory.java
@@ -199,9 +199,23 @@ public class Inventory implements Container, Nameable {
     }
 
     public int findSlotMatchingUnusedItem(ItemStack stack) {
+        // Kiterino start - Add predicate support for recipe book
+        return findSlotMatchingUnusedItem(stack, null);
+    }
+    public int findSlotMatchingUnusedItem(ItemStack stack, @org.jetbrains.annotations.Nullable java.util.function.Predicate<org.bukkit.inventory.ItemStack> validator) {
+        // Kiterino end - Add predicate support for recipe book
         for (int i = 0; i < this.items.size(); ++i) {
             ItemStack itemstack1 = (ItemStack) this.items.get(i);
 
+            // Kiterino start - Add predicate support for recipe book
+            if (validator != null) {
+                if (!itemstack1.isEmpty() && validator.test(itemstack1.asBukkitMirror()) && !itemstack1.isDamaged() && !itemstack1.isEnchanted() && !itemstack1.has(DataComponents.CUSTOM_NAME)) {
+                    return i;
+                }
+                continue;
+            }
+            // Kiterino end - Add predicate support for recipe book
+
             if (!itemstack1.isEmpty() && ItemStack.isSameItemSameComponents(stack, itemstack1) && !itemstack1.isDamaged() && !itemstack1.isEnchanted() && !itemstack1.has(DataComponents.CUSTOM_NAME)) {
                 return i;
             }
