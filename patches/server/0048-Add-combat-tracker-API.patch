+    // Kiterino start - Add combat tracker API
+    @Override
+    public org.bukkit.damage.DamageSource getDamageSource() {
+        return new org.bukkit.craftbukkit.damage.CraftDamageSource(this.source);
+    }
+
+    @Override
+    public float getDamage() {
+        return this.damage;
+    }
+    // Kiterino end - Add combat tracker API
 }
