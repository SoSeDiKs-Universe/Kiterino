--- /dev/null
+++ b/src/main/java/me/sosedik/kiterino/world/damagesource/CraftCombatTracker.java
@@ -0,0 +1,64 @@
+package me.sosedik.kiterino.world.damagesource;
+
+import io.papermc.paper.adventure.PaperAdventure;
+import net.kyori.adventure.text.Component;
+import net.minecraft.world.damagesource.FallLocation;
+import org.bukkit.craftbukkit.damage.CraftDamageSource;
+import org.bukkit.damage.DamageSource;
+import org.bukkit.entity.LivingEntity;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.List;
+
+public class CraftCombatTracker implements CombatTracker {
+
+    private final net.minecraft.world.damagesource.CombatTracker handle;
+
+    public CraftCombatTracker(@NotNull net.minecraft.world.damagesource.CombatTracker handle) {
+        this.handle = handle;
+    }
+
+    @Override
+    public @NotNull LivingEntity getEntity() {
+        return this.handle.mob.getBukkitLivingEntity();
+    }
+
+    @SuppressWarnings("unchecked")
+    @Override
+    public @NotNull List<CombatEntry> getCombatEntries() {
+        return (List<CombatEntry>) ((List<? extends CombatEntry>) this.handle.entries);
+    }
+
+    @Override
+    public @NotNull CombatEntry createCombatEntry(@NotNull DamageSource damageSource, float damage) {
+        var fallLocation = FallLocation.getCurrentFallLocation(this.handle.mob);
+        return new net.minecraft.world.damagesource.CombatEntry(((CraftDamageSource) damageSource).getHandle(), damage, fallLocation, this.handle.mob.fallDistance);
+    }
+
+    @Override
+    public @Nullable CombatEntry getMostSignificantFall() {
+        return this.handle.getMostSignificantFall();
+    }
+
+    @Override
+    public boolean isInCombat() {
+        return this.handle.inCombat;
+    }
+
+    @Override
+    public int getCombatDuration() {
+        return this.handle.getCombatDuration();
+    }
+
+    @Override
+    public void recordDamage(@NotNull DamageSource damageSource, float damage) {
+        this.handle.recordDamage(((CraftDamageSource) damageSource).getHandle(), damage);
+    }
+
+    @Override
+    public @NotNull Component getDeathMessage() {
+        return PaperAdventure.asAdventure(this.handle.getDeathMessage());
+    }
+
+}
