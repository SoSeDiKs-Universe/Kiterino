From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Thu, 20 Jun 2024 20:02:03 +0300
Subject: [PATCH] Expose invalid world to PlayerSpawnLocationEvent


diff --git a/src/main/java/net/minecraft/server/players/PlayerList.java b/src/main/java/net/minecraft/server/players/PlayerList.java
index 1db55b8ea73f6eab8dd38bfc5104d7f520bd533f..ce549ad8aed721664df0929a4de197929dc565d1 100644
--- a/src/main/java/net/minecraft/server/players/PlayerList.java
+++ b/src/main/java/net/minecraft/server/players/PlayerList.java
@@ -258,7 +258,12 @@ public abstract class PlayerList {
             player.spawnReason = org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.DEFAULT; // set Player SpawnReason to DEFAULT on first login
             // Paper start - reset to main world spawn if first spawn or invalid world
         }
+        // Kiterino start - Expose invalid world to PlayerSpawnLocationEvent
+        Location initialLocation = null;
+        String initialDimensionId = optional.map(compoundTag -> compoundTag.getString("Dimension")).orElse(null);
+        // Kiterino end - Expose invalid world to PlayerSpawnLocationEvent
         if (optional.isEmpty() || invalidPlayerWorld[0]) {
+            initialLocation = CraftLocation.toBukkit(player.position(), null, player.getBukkitYaw(), player.getXRot()); // Kiterino - Expose invalid world to PlayerSpawnLocationEvent
             // Paper end - reset to main world spawn if first spawn or invalid world
             player.moveTo(player.adjustSpawnLocation(worldserver1, worldserver1.getSharedSpawnPos()).getBottomCenter(), worldserver1.getSharedSpawnAngle(), 0.0F); // Paper - MC-200092 - fix first spawn pos yaw being ignored
         }
@@ -268,7 +273,7 @@ public abstract class PlayerList {
 
         // Spigot start - spawn location event
         Player spawnPlayer = player.getBukkitEntity();
-        org.spigotmc.event.player.PlayerSpawnLocationEvent ev = new org.spigotmc.event.player.PlayerSpawnLocationEvent(spawnPlayer, spawnPlayer.getLocation());
+        org.spigotmc.event.player.PlayerSpawnLocationEvent ev = new org.spigotmc.event.player.PlayerSpawnLocationEvent(spawnPlayer, spawnPlayer.getLocation(), initialLocation, initialDimensionId); // Kiterino - Expose invalid world to PlayerSpawnLocationEvent
         this.cserver.getPluginManager().callEvent(ev);
 
         Location loc = ev.getSpawnLocation();
