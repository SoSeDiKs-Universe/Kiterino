From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Wed, 24 May 2023 17:13:26 +0300
Subject: [PATCH] Forced panic mode API


diff --git a/src/main/java/net/minecraft/world/entity/Entity.java b/src/main/java/net/minecraft/world/entity/Entity.java
index 75d7ce413cc002f17e443ee9232531d894ec7f24..0e753d9cf4328da809da4e3dcd00314e709a153b 100644
--- a/src/main/java/net/minecraft/world/entity/Entity.java
+++ b/src/main/java/net/minecraft/world/entity/Entity.java
@@ -349,6 +349,7 @@ public abstract class Entity implements SyncedDataHolder, Nameable, EntityAccess
     public final RandomSource random;
     public int tickCount;
     private int remainingFireTicks;
+    public int forcePanicTicks; public boolean isForcePanicking() { return forcePanicTicks > 0; } // Kiterino - Forced panic mode API
     public boolean wasTouchingWater;
     protected Object2DoubleMap<TagKey<Fluid>> fluidHeight;
     protected boolean wasEyeInWater;
@@ -927,6 +928,12 @@ public abstract class Entity implements SyncedDataHolder, Nameable, EntityAccess
             }
         }
 
+        // Kiterino start - Forced panic mode API
+        if (this.forcePanicTicks > 0) {
+            this.forcePanicTicks--;
+        }
+        // Kiterino end - Forced panic mode API
+
         if (this.isInLava()) {
             this.lavaHurt();
             this.fallDistance *= 0.5F;
diff --git a/src/main/java/net/minecraft/world/entity/ai/behavior/AnimalPanic.java b/src/main/java/net/minecraft/world/entity/ai/behavior/AnimalPanic.java
index d0212665c3fd6182d2c63356ba4e7c49b944eb62..8cea002c314509f6c0856f0fc9bf2d9f6731fa77 100644
--- a/src/main/java/net/minecraft/world/entity/ai/behavior/AnimalPanic.java
+++ b/src/main/java/net/minecraft/world/entity/ai/behavior/AnimalPanic.java
@@ -43,7 +43,7 @@ public class AnimalPanic<E extends PathfinderMob> extends Behavior<E> {
     @Override
     protected boolean checkExtraStartConditions(ServerLevel world, E entity) {
         return entity.getBrain().getMemory(MemoryModuleType.HURT_BY).map(hurtBy -> hurtBy.is(this.panicCausingDamageTypes.apply(entity))).orElse(false)
-            || entity.getBrain().hasMemoryValue(MemoryModuleType.IS_PANICKING);
+            || entity.getBrain().hasMemoryValue(MemoryModuleType.IS_PANICKING) || entity.isForcePanicking(); // Kiterino - Forced panic mode API
     }
 
     @Override
diff --git a/src/main/java/net/minecraft/world/entity/ai/goal/PanicGoal.java b/src/main/java/net/minecraft/world/entity/ai/goal/PanicGoal.java
index 20d4e3fb00a9eaac8484e95329bd64a368872b59..bec81c864a07d53a31da4e6e7437b2418020d240 100644
--- a/src/main/java/net/minecraft/world/entity/ai/goal/PanicGoal.java
+++ b/src/main/java/net/minecraft/world/entity/ai/goal/PanicGoal.java
@@ -59,7 +59,7 @@ public class PanicGoal extends Goal {
     }
 
     protected boolean shouldPanic() {
-        return this.mob.getLastDamageSource() != null && this.mob.getLastDamageSource().is(this.panicCausingDamageTypes.apply(this.mob));
+        return (this.mob.getLastDamageSource() != null && this.mob.getLastDamageSource().is(this.panicCausingDamageTypes.apply(this.mob))) || this.mob.isForcePanicking(); // Kiterino - Forced panic mode API
     }
 
     protected boolean findRandomPosition() {
diff --git a/src/main/java/net/minecraft/world/entity/animal/Fox.java b/src/main/java/net/minecraft/world/entity/animal/Fox.java
index 5d13c8827c0746d180b5a838b3f2be2cbd2cba14..425568df843a9b3bc36ea73e85ff7b6702b2b01f 100644
--- a/src/main/java/net/minecraft/world/entity/animal/Fox.java
+++ b/src/main/java/net/minecraft/world/entity/animal/Fox.java
@@ -954,7 +954,7 @@ public class Fox extends Animal implements VariantHolder<Fox.Type> {
 
         @Override
         public boolean shouldPanic() {
-            return !Fox.this.isDefending() && super.shouldPanic();
+            return (!Fox.this.isDefending() && super.shouldPanic()) || this.mob.isForcePanicking(); // Kiterino - Forced panic mode API
         }
     }
 
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 4b7d38a5ac6247c6e9d71ac7f3b65765ed3cf3ee..c9883eec3d09e14325351cc267e6c75b0423eaf7 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1338,4 +1338,16 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
         return !getHandle().dismountsUnderwater();
     }
     // Purpur end
+
+    // Kiterino start - Forced panic mode API
+    @Override
+    public int getPanicTicks() {
+        return getHandle().forcePanicTicks;
+    }
+
+    @Override
+    public void setPanicTicks(int ticks) {
+        getHandle().forcePanicTicks = Math.max(0, ticks);
+    }
+    // Kiterino end - Forced panic mode API
 }
