index 0000000000000000000000000000000000000000..5372d7336d677f6b89b7a7205807a227999fbf39
--- /dev/null
+++ b/src/main/java/me/sosedik/kiterino/util/KiterinoUnsafeUtil.java
@@ -0,0 +1,52 @@
+package me.sosedik.kiterino.util;
+
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import sun.misc.Unsafe;
+
+import java.lang.reflect.Field;
+
+final class KiterinoUnsafeUtil {
+
+    private KiterinoUnsafeUtil() {
+        throw new IllegalStateException("Utility class");
+    }
+
+    private static Unsafe unsafe;
+
+    static {
+        try {
+            Field unsafeField = Unsafe.class.getDeclaredField("theUnsafe");
+            unsafeField.setAccessible(true);
+            unsafe = (Unsafe) unsafeField.get(null);
+        } catch(Exception e) {
+            e.printStackTrace();
+        }
+    }
+
+    static @NotNull Field getField(@NotNull Class<?> clazz, @NotNull String fieldName) {
+        try {
+            Field field = clazz.getDeclaredField(fieldName);
+            field.setAccessible(true);
+            return field;
+        } catch (NoSuchFieldException e) {
+            throw new KiterinoDataInjectorRuntimeException("Couldn't get field", e);
+        }
+    }
+
+    static void setField(@NotNull Field field, @Nullable Object value) {
+        Object fieldBase = unsafe.staticFieldBase(field);
+        long fieldOffset = unsafe.staticFieldOffset(field);
+
+        unsafe.putObject(fieldBase, fieldOffset, value);
+    }
+
+    static <T> T allocateInstance(@NotNull Class<T> tClass) {
+        try {
+            return (T) unsafe.allocateInstance(tClass);
+        } catch (Exception e) {
+            throw new KiterinoDataInjectorRuntimeException("Couldn't allocate new instance", e);
+        }
+    }
+
+}
