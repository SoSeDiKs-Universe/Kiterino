From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Wed, 19 Jun 2024 01:40:23 +0300
Subject: [PATCH] Temporary solution for respawn events parity until Paper PR
 8705 is merged


diff --git a/src/main/java/net/minecraft/server/players/PlayerList.java b/src/main/java/net/minecraft/server/players/PlayerList.java
index e1d195ab8b005edd7fcded810ddf903b47c000a1..fdfff436e350ddd1d74db75d9734f727bb17059f 100644
--- a/src/main/java/net/minecraft/server/players/PlayerList.java
+++ b/src/main/java/net/minecraft/server/players/PlayerList.java
@@ -806,6 +806,7 @@ public abstract class PlayerList {
         }
         // Paper start - Add PlayerPostRespawnEvent
         boolean isBedSpawn = false;
+        boolean isAnchorSpawn = false; // Kiterino - Parity for respawn events
         boolean isRespawn = false;
         // Paper end - Add PlayerPostRespawnEvent
 
@@ -871,6 +872,7 @@ public abstract class PlayerList {
             BlockState iblockdata = worldserver2.getBlockState(blockposition);
 
             if (iblockdata.is(Blocks.RESPAWN_ANCHOR)) {
+                isAnchorSpawn = true; // Kiterino - Parity for respawn events
                 entityplayer1.connection.send(new ClientboundSoundPacket(SoundEvents.RESPAWN_ANCHOR_DEPLETE, SoundSource.BLOCKS, (double) blockposition.getX(), (double) blockposition.getY(), (double) blockposition.getZ(), 1.0F, 1.0F, worldserver.getRandom().nextLong()));
             }
             // Paper start - Add PlayerPostRespawnEvent
@@ -902,7 +904,13 @@ public abstract class PlayerList {
 
         // Paper start - Add PlayerPostRespawnEvent
         if (isRespawn) {
-            cserver.getPluginManager().callEvent(new com.destroystokyo.paper.event.player.PlayerPostRespawnEvent(entityplayer.getBukkitEntity(), location, isBedSpawn));
+            // Kiterino start - Parity for respawn events
+            var flags = com.google.common.collect.ImmutableSet.<org.bukkit.event.player.PlayerRespawnEvent.RespawnFlag>builder();
+            if (reason == RespawnReason.END_PORTAL) {
+                flags.add(PlayerRespawnEvent.RespawnFlag.END_PORTAL);
+            }
+            cserver.getPluginManager().callEvent(new com.destroystokyo.paper.event.player.PlayerPostRespawnEvent(entityplayer.getBukkitEntity(), location, isBedSpawn && !isAnchorSpawn, isAnchorSpawn, reason, flags));
+            // Kiterino end - Parity for respawn events
         }
         // Paper end - Add PlayerPostRespawnEvent
 
