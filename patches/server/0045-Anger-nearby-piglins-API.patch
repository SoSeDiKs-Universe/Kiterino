Subject: [PATCH] Anger nearby piglins API


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index f40ecca11953fab39ce24816de7e9be1b1f42583..7595bc3764d756ce9709a9fec50be535fbb69126 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -3710,4 +3710,11 @@ public class CraftPlayer extends CraftHumanEntity implements Player {
         this.getHandle().connection.send(new net.minecraft.network.protocol.game.ClientboundContainerSetSlotPacket(0, stateId, slot, CraftItemStack.asNMSCopy(item)));
     }
     // Kiterino end - Send ItemStack API
+
+    // Kiterino start - Anger nearby piglins API
+    @Override
+    public void angerNearbyPiglins(boolean blockOpen) {
+        net.minecraft.world.entity.monster.piglin.PiglinAi.angerNearbyPiglins(this.getHandle().serverLevel(), this.getHandle(), blockOpen);
+    }
+    // Kiterino end - Anger nearby piglins API
 }
