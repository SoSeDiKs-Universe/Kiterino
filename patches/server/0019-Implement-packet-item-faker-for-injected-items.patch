From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Thu, 16 May 2024 06:40:03 +0300
Subject: [PATCH] Implement packet item faker for injected items

Forces default item faker for injected items as to not kick the client from the server because of modded items

diff --git a/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandlerImpl.java b/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandlerImpl.java
index d22f5da4d506f2c74e187717d13f14d38b759a5d..aad30050cbef75395ed2d47417c80d4d4bd46ee4 100644
--- a/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandlerImpl.java
+++ b/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandlerImpl.java
@@ -140,7 +140,11 @@ public class ItemModifiersHandlerImpl extends ItemModifiersHandler {
     }
 
     public static void init() {
+        ItemModifier itemFaker = modifiers.get(KiterinoItemModifierImpl.MODIFIER_KEY);
         modifiers.clear(); // In case of reload. Not supported, but eh
+        if (itemFaker != null) {
+            modifiers.put(itemFaker.getModifierId(), itemFaker);
+        }
         if (ItemModifiersHandler.itemModifiersHandler == null) ItemModifiersHandler.itemModifiersHandler = new ItemModifiersHandlerImpl();
         ItemPacketContextInitializer.init();
     }
diff --git a/src/main/java/me/sosedik/kiterino/modifier/item/KiterinoItemModifierImpl.java b/src/main/java/me/sosedik/kiterino/modifier/item/KiterinoItemModifierImpl.java
new file mode 100644
index 0000000000000000000000000000000000000000..16242986d124173007c4e18dd6219e5d9e9f8061
--- /dev/null
+++ b/src/main/java/me/sosedik/kiterino/modifier/item/KiterinoItemModifierImpl.java
@@ -0,0 +1,39 @@
+package me.sosedik.kiterino.modifier.item;
+
+import org.bukkit.NamespacedKey;
+import org.jetbrains.annotations.ApiStatus;
+import org.jetbrains.annotations.NotNull;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Handles visual modification for injected items
+ */
+@ApiStatus.Internal
+public final class KiterinoItemModifierImpl extends ItemModifier {
+
+    public static final NamespacedKey MODIFIER_KEY = new NamespacedKey(NamespacedKey.KITERINO, "item_faker");
+    public static final KiterinoItemModifierImpl MODIFIER_IMPL = new KiterinoItemModifierImpl();
+
+    private final Map<NamespacedKey, KiterinoItemModifier> modifiers = new HashMap<>();
+
+    private KiterinoItemModifierImpl() {
+        super(MODIFIER_KEY);
+    }
+
+    public void add(@NotNull NamespacedKey key, @NotNull KiterinoItemModifier modifier) {
+        this.modifiers.put(key, modifier);
+    }
+
+    @Override
+    public @NotNull ModificationResult modify(@NotNull ItemContextBox contextBox) {
+        KiterinoItemModifier modifier = modifiers.get(contextBox.getItem().getType().getKey());
+        if (modifier != null) {
+            modifier.modify(contextBox);
+            return ModificationResult.OK;
+        }
+        return ModificationResult.PASS;
+    }
+
+}
diff --git a/src/main/java/me/sosedik/kiterino/registry/data/KiterinoItemRegistryEntity.java b/src/main/java/me/sosedik/kiterino/registry/data/KiterinoItemRegistryEntity.java
index 60403dd5ce27c84057e6c9e59c810b3e318e1d98..fd737493e557ff468bc31a9814eced0a07702ac4 100644
