 		// DataComponentMap components = item.components();
@@ -109,9 +119,31 @@ public class KiterinoItemRegistryEntity implements ItemRegistryEntity {
 			return this;
 		}
 
+		@Override
+		public @NonNull Builder modifier(@Nullable KiterinoItemModifier modifier) {
+			this.modifier = modifier;
+			return this;
+		}
+
+		@SuppressWarnings("unchecked")
+		private @NonNull KiterinoItemModifier buildModifier() {
+			return box -> {
+				ItemStack item = box.getItem();
+				this.components.forEach((type, value) -> {
+					if (type instanceof DataComponentType.Valued<?> valued) {
+						item.setData((DataComponentType.Valued<Object>) valued, value);
+					} else if (type instanceof DataComponentType.NonValued nonValued) {
+						item.setData(nonValued);
+					}
+				});
+				if (this.modifier != null) this.modifier.modify(box);
+			};
+		}
+
 		@SuppressWarnings("unchecked")
 		@Override
 		public @NonNull Item build() {
+			if (this.modifier != null) KiterinoItemModifierImpl.MODIFIER_IMPL.add(new org.bukkit.NamespacedKey(this.itemKey.key().namespace(), this.itemKey.key().value()), buildModifier());
 			Item item = this.nmsItem;
 			if (item == null) {
 				var properties = new Item.Properties();
diff --git a/src/main/java/me/sosedik/kiterino/util/KiterinoBootstrapMaterialInjectorImpl.java b/src/main/java/me/sosedik/kiterino/util/KiterinoBootstrapMaterialInjectorImpl.java
