From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Mon, 24 Jun 2024 18:42:05 +0300
Subject: [PATCH] Better EntityShootBowEvent cancellation

Don't increase stats / play bow sound if event was cancelled

diff --git a/src/main/java/net/minecraft/world/item/BowItem.java b/src/main/java/net/minecraft/world/item/BowItem.java
index 58fa528e4b2589d362eb976afd6221cd94f2623c..832bc0264c051916131d3d6c4dce8ec0aa0b2aed 100644
--- a/src/main/java/net/minecraft/world/item/BowItem.java
+++ b/src/main/java/net/minecraft/world/item/BowItem.java
@@ -43,7 +43,7 @@ public class BowItem extends ProjectileWeaponItem {
                 } else {
                     List<ItemStack> list = draw(stack, itemStack, player);
                     if (world instanceof ServerLevel serverLevel && !list.isEmpty()) {
-                        this.shoot(serverLevel, player, player.getUsedItemHand(), stack, list, f * 3.0F, (float) world.purpurConfig.bowProjectileOffset, f == 1.0F, null); // Purpur
+                        if (!this.shoot(serverLevel, player, player.getUsedItemHand(), stack, list, f * 3.0F, (float) world.purpurConfig.bowProjectileOffset, f == 1.0F, null)) return false; // Purpur // Kiterino - Better EntityShootBowEvent cancellation
                     }
 
                     world.playSound(
diff --git a/src/main/java/net/minecraft/world/item/CrossbowItem.java b/src/main/java/net/minecraft/world/item/CrossbowItem.java
index 86204c2ab5bbd5d45ddb1d626f844d91ccae6b4f..2375644dca8953b1dce9c62ac8470d40bb1e7a15 100644
--- a/src/main/java/net/minecraft/world/item/CrossbowItem.java
+++ b/src/main/java/net/minecraft/world/item/CrossbowItem.java
@@ -202,7 +202,7 @@ public class CrossbowItem extends ProjectileWeaponItem {
         if (world instanceof ServerLevel serverLevel) {
             ChargedProjectiles chargedProjectiles = stack.set(DataComponents.CHARGED_PROJECTILES, ChargedProjectiles.EMPTY);
             if (chargedProjectiles != null && !chargedProjectiles.isEmpty()) {
-                this.shoot(serverLevel, shooter, hand, stack, chargedProjectiles.getItems(), speed, divergence, shooter instanceof Player, target);
+                if (!this.shoot(serverLevel, shooter, hand, stack, chargedProjectiles.getItems(), speed, divergence, shooter instanceof Player, target)) return; // Kiterino - Better EntityShootBowEvent cancellation
                 if (shooter instanceof ServerPlayer serverPlayer) {
                     CriteriaTriggers.SHOT_CROSSBOW.trigger(serverPlayer, stack);
                     serverPlayer.awardStat(Stats.ITEM_USED.get(stack.getItem()));
diff --git a/src/main/java/net/minecraft/world/item/ProjectileWeaponItem.java b/src/main/java/net/minecraft/world/item/ProjectileWeaponItem.java
index c2ae50872cead7202246b9cce4db6e0a81e1cf5f..178fe2edf9e9f77e60ae2570e284c32488bf2f8b 100644
--- a/src/main/java/net/minecraft/world/item/ProjectileWeaponItem.java
+++ b/src/main/java/net/minecraft/world/item/ProjectileWeaponItem.java
@@ -41,7 +41,7 @@ public abstract class ProjectileWeaponItem extends Item {
 
     public abstract int getDefaultProjectileRange();
 
-    protected void shoot(ServerLevel world, LivingEntity shooter, InteractionHand hand, ItemStack stack, List<ItemStack> projectiles, float speed, float divergence, boolean critical, @Nullable LivingEntity target) {
+    protected boolean shoot(ServerLevel world, LivingEntity shooter, InteractionHand hand, ItemStack stack, List<ItemStack> projectiles, float speed, float divergence, boolean critical, @Nullable LivingEntity target) { // Kiterino - void -> boolean - Better EntityShootBowEvent cancellation
         float f2 = EnchantmentHelper.processProjectileSpread(world, stack, shooter, 0.0F);
         float f3 = projectiles.size() == 1 ? 0.0F : 2.0F * f2 / (float) (projectiles.size() - 1);
         float f4 = (float) ((projectiles.size() - 1) % 2) * f3 / 2.0F;
@@ -61,7 +61,7 @@ public abstract class ProjectileWeaponItem extends Item {
                 org.bukkit.event.entity.EntityShootBowEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callEntityShootBowEvent(shooter, stack, itemstack1, iprojectile, hand, speed, true);
                 if (event.isCancelled()) {
                     event.getProjectile().remove();
-                    return;
+                    return false; // Kiterino - Better EntityShootBowEvent cancellation
                 }
 
                 if (event.getProjectile() == iprojectile.getBukkitEntity()) {
@@ -69,7 +69,7 @@ public abstract class ProjectileWeaponItem extends Item {
                         if (shooter instanceof net.minecraft.server.level.ServerPlayer) {
                             ((net.minecraft.server.level.ServerPlayer) shooter).getBukkitEntity().updateInventory();
                         }
-                        return;
+                        return false; // Kiterino - Better EntityShootBowEvent cancellation
                     }
                 }
                 // CraftBukkit end
@@ -80,6 +80,7 @@ public abstract class ProjectileWeaponItem extends Item {
             }
         }
 
+        return true; // Kiterino - Better EntityShootBowEvent cancellation
     }
 
     protected int getDurabilityUse(ItemStack projectile) {
