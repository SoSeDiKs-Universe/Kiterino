@@ -155,10 +158,24 @@ public class ItemModifiersHandlerImpl extends ItemModifiersHandler {
 			case ClientboundUpdateRecipesPacket packet -> handle(player, packet);
 			case ClientboundUpdateAdvancementsPacket packet -> handle(player, packet);
 			case ClientboundMerchantOffersPacket packet -> handle(player, packet);
+			case ClientboundSystemChatPacket packet -> handle(player, packet);
 			default -> initialPacket;
 		};
 	}
 
+	private static @NotNull Packet<?> handle(@NotNull CraftPlayer player, @NotNull ClientboundSystemChatPacket initialPacket) {
+		if (initialPacket.overlay()) {
+			return initialPacket;
+		}
+
+		boolean prev = ComponentSerialization.DONT_RENDER_TRANSLATABLES.get();
+		ComponentSerialization.DONT_RENDER_TRANSLATABLES.set(true);
+		Component component = initialPacket.content();
+		component = ComponentSerialization.replaceHoverItems(player, player.locale(), component);
+		ComponentSerialization.DONT_RENDER_TRANSLATABLES.set(prev);
+		return new ClientboundSystemChatPacket(component, false);
+	}
+
 	@SuppressWarnings({"unchecked"})
 	private static @NotNull Packet<?> handle(@NotNull CraftPlayer player, @NotNull ClientboundBundlePacket initialPacket) {
 		if (!(initialPacket.subPackets() instanceof ArrayList list)) {
diff --git a/src/main/java/net/minecraft/network/chat/ComponentSerialization.java b/src/main/java/net/minecraft/network/chat/ComponentSerialization.java
index 22c6a324dedeb315eac2d3d3f55d2f3a9eebb0ad..42392058d181eaf9752ed26508a07f01d43d6a4d 100644
--- a/src/main/java/net/minecraft/network/chat/ComponentSerialization.java
+++ b/src/main/java/net/minecraft/network/chat/ComponentSerialization.java
@@ -54,13 +54,73 @@ public class ComponentSerialization {
 
             @Override
             public void encode(RegistryFriendlyByteBuf registryFriendlyByteBuf, Component object) {
+                // Kiterino start - Parse items in show_item hover event
+                if (me.sosedik.kiterino.KiterinoConfig.parseItemHoversEverywhere && !DONT_RENDER_TRANSLATABLES.get()) {
+                    java.util.Locale locale = registryFriendlyByteBuf.adventure$locale;
+                    if (locale == null) {
+                        locale = java.util.Locale.ENGLISH;
+                    }
+                    object = replaceHoverItems(null, locale, object);
+                }
+                Component finalObject = object;
+                // Kiterino end - Parse items in show_item hover event
                 RegistryOps<net.minecraft.nbt.Tag> registryOps = registryFriendlyByteBuf.registryAccess().createSerializationContext(net.minecraft.nbt.NbtOps.INSTANCE);
                 net.minecraft.nbt.Tag tag = (DONT_RENDER_TRANSLATABLES.get() ? CODEC : ComponentSerialization.localizedCodec(registryFriendlyByteBuf.adventure$locale))
-                    .encodeStart(registryOps, object).getOrThrow(error -> new io.netty.handler.codec.EncoderException("Failed to encode: " + error + " " + object));
+                    .encodeStart(registryOps, object).getOrThrow(error -> new io.netty.handler.codec.EncoderException("Failed to encode: " + error + " " + finalObject)); // Kiterino - Parse items in show_item hover event
                 this.streamCodec.encode(registryFriendlyByteBuf, tag);
             }
         };
     }
+    // Kiterino start - Parse items in show_item hover event
+    public static Component replaceHoverItems(@org.jetbrains.annotations.Nullable org.bukkit.craftbukkit.entity.CraftPlayer player, java.util.Locale locale, Component component) {
+        // Go through children first
+        List<Component> children = component.getSiblings();
+        if (!children.isEmpty()) {
+            // Adventure components have immutable children/siblings
+            if (!(component instanceof MutableComponent)) {
+                component = component.copy();
+                children = component.getSiblings();
+            }
+            children.replaceAll(child -> replaceHoverItems(player, locale, child));
+        }
+
+        // Translatables may have component arguments
+        if (component.getContents() instanceof TranslatableContents translatable) {
+            Object[] args = translatable.getArgs();
+            for (int i = 0; i < args.length; i++) {
+                if (!(args[i] instanceof Component arg)) continue;
+
+                args[i] = replaceHoverItems(player, locale, arg);
+            }
+        }
+
+        // Finally replace hover item if found
+        HoverEvent hoverEvent = component.getStyle().hoverEvent;
+        if (hoverEvent == null) {
+            return component;
+        }
+
+        HoverEvent.ItemStackInfo value = hoverEvent.getValue(HoverEvent.Action.SHOW_ITEM);
+        if (value == null) {
+            return component;
+        }
+
+        var original = value.getItemStack();
+        var context = me.sosedik.kiterino.modifier.item.context.ItemModifierContext.EMPTY;
+        var contextBox = new me.sosedik.kiterino.modifier.item.ItemContextBox(player, locale, me.sosedik.kiterino.modifier.item.context.ItemModifierContextType.CHAT_ITEM, context, original.asBukkitCopy());
+        var bukkitItem = me.sosedik.kiterino.modifier.item.ItemModifier.modifyItem(contextBox);
+        if (bukkitItem != null) {
+            Style style = component.getStyle().withHoverEvent(new HoverEvent(HoverEvent.Action.SHOW_ITEM, new HoverEvent.ItemStackInfo(net.minecraft.world.item.ItemStack.fromBukkitCopy(bukkitItem))));
+            if (component instanceof MutableComponent mutableComponent) {
+                mutableComponent.setStyle(style);
+            } else {
+                component = component.copy().setStyle(style);
+            }
+        }
+
+        return component;
+    }
+    // Kiterino end - Parse items in show_item hover event
     // Paper end - adventure; use locale from bytebuf for translation
     public static final StreamCodec<RegistryFriendlyByteBuf, Optional<Component>> TRUSTED_OPTIONAL_STREAM_CODEC = TRUSTED_STREAM_CODEC.apply(
         ByteBufCodecs::optional
