From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Sun, 23 Jun 2024 15:28:30 +0300
Subject: [PATCH] Allow resending entity metadata


diff --git a/src/main/java/net/minecraft/network/syncher/SynchedEntityData.java b/src/main/java/net/minecraft/network/syncher/SynchedEntityData.java
index 0f99733660f91280e4c6262cf75b3c9cae86f65a..5b91aad7102bb66c11c547fce3791710ad0ece0e 100644
--- a/src/main/java/net/minecraft/network/syncher/SynchedEntityData.java
+++ b/src/main/java/net/minecraft/network/syncher/SynchedEntityData.java
@@ -81,6 +81,16 @@ public class SynchedEntityData {
     }
     // CraftBukkit end
 
+    // Kiterino start - Allow resending entity metadata
+    public void markDirty(int index) {
+        if (index >= this.itemsById.length) {
+            return;
+        }
+        this.itemsById[index].setDirty(true);
+        this.isDirty = true;
+    }
+    // Kiterino end - Allow resending entity metadata
+
     public boolean isDirty() {
         return this.isDirty;
     }
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index da22e8ed23b721f29270c03cbd207e83ee9c294c..379a8af10dff4949b76d5e970e28d17ccec4d7ff 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1463,4 +1463,11 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
         return getHandle().setRider(((CraftPlayer) rider).getHandle());
     }
     // Kiterino end - Allow setting entity's rider
+
+    // Kiterino start - Allow resending entity metadata
+    @Override
+    public void resendMetadata(int index) {
+        getHandle().getEntityData().markDirty(index);
+    }
+    // Kiterino end - Allow resending entity metadata
 }
