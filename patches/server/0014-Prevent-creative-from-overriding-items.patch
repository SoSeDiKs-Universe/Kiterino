From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Thu, 2 May 2024 02:57:50 +0300
Subject: [PATCH] Prevent creative from overriding items

Adds "items.prevent-creative-override" option to prevent creative from overriding items.
The original item is stored as nbt in custom_data component when sending to player and is restored later from nbt.

diff --git a/src/main/java/me/sosedik/kiterino/KiterinoConfig.java b/src/main/java/me/sosedik/kiterino/KiterinoConfig.java
index 31b2b21cb4de6cb975d5fbc1480eb32d23ab56f6..f51c974137edad3cb03230e93fbcae744c877e58 100644
--- a/src/main/java/me/sosedik/kiterino/KiterinoConfig.java
+++ b/src/main/java/me/sosedik/kiterino/KiterinoConfig.java
@@ -129,4 +129,11 @@ public final class KiterinoConfig {
     }
     // Kiterino end - Item Modifiers API
 
+    // Kiterino start - Prevent creative from overriding items
+    public static boolean preventCreativeItemOverride;
+    private static void preventCreativeItemsOverride() {
+        preventCreativeItemOverride = getBoolean(config, "items.prevent-creative-override", true, "Prevent creative from overriding items");
+    }
+    // Kiterino end - Prevent creative from overriding items
+
 }
diff --git a/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandlerImpl.java b/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandlerImpl.java
index ff72162914c7a1396f9b3607eee4c7f6dfd392d6..04dc09b1b96ed6044660eb4c781316db1a26fa28 100644
--- a/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandlerImpl.java
+++ b/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandlerImpl.java
@@ -20,6 +20,8 @@ import me.sosedik.kiterino.modifier.item.context.packet.UnknownEntityDataContext
 import net.minecraft.advancements.Advancement;
 import net.minecraft.advancements.AdvancementHolder;
 import net.minecraft.advancements.DisplayInfo;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.nbt.CompoundTag;
 import net.minecraft.network.protocol.Packet;
 import net.minecraft.network.protocol.game.ClientboundBundlePacket;
 import net.minecraft.network.protocol.game.ClientboundContainerSetContentPacket;
@@ -658,7 +660,21 @@ public class ItemModifiersHandlerImpl extends ItemModifiersHandler {
 		var bukkitItem = ItemModifier.modifyItem(contextBox);
 		if (bukkitItem == null) return null;
 
-		return ItemStack.fromBukkitCopy(bukkitItem);
+		// Kiterino start - Prevent creative from overriding items
+		ItemStack itemStack = ItemStack.fromBukkitCopy(bukkitItem);
+		CraftPlayer player = (CraftPlayer) contextBox.getViewer();
+		if (player != null && me.sosedik.kiterino.KiterinoConfig.preventCreativeItemOverride && player.getGameMode() == org.bukkit.GameMode.CREATIVE) {
+			net.minecraft.world.item.component.CustomData customData = itemStack.get(DataComponents.CUSTOM_DATA);
+			if (customData == null) {
+				customData = net.minecraft.world.item.component.CustomData.of(new CompoundTag());
+				customData.getUnsafe().put("kiterino_og_item", original.saveOptional(player.getHandle().registryAccess()));
+				itemStack.set(DataComponents.CUSTOM_DATA, customData);
+			} else {
+				customData.getUnsafe().put("kiterino_og_item", original.saveOptional(player.getHandle().registryAccess()));
+			}
+		}
+		return itemStack;
+		// Kiterino end - Prevent creative from overriding items
 	}
 
 }
diff --git a/src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java b/src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java
index 88eb3774f688bcff383efa7f113bd0b1b97d8a11..f52260ba9a98b825bbaef4f7e3ca8246ea0d4a48 100644
--- a/src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java
+++ b/src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java
@@ -106,6 +106,11 @@ public class ServerPlayerGameMode {
     protected void setGameModeForPlayer(GameType gameMode, @Nullable GameType previousGameMode) {
         this.previousGameModeForPlayer = previousGameMode;
         this.gameModeForPlayer = gameMode;
+        // Kiterino start - Prevent creative from overriding items
+        if (me.sosedik.kiterino.KiterinoConfig.preventCreativeItemOverride && gameMode == GameType.CREATIVE) {
+            this.player.containerMenu.sendAllDataToRemote();
+        }
+        // Kiterino end - Prevent creative from overriding items
         gameMode.updatePlayerAbilities(this.player.getAbilities());
     }
 
diff --git a/src/main/java/net/minecraft/world/item/ItemStack.java b/src/main/java/net/minecraft/world/item/ItemStack.java
index 5964c2e77e9f21c72d9e0655e5f48d2798317779..00e417c705236de803d58c58351467831f6c3c0c 100644
--- a/src/main/java/net/minecraft/world/item/ItemStack.java
+++ b/src/main/java/net/minecraft/world/item/ItemStack.java
@@ -169,6 +169,15 @@ public final class ItemStack implements DataComponentHolder {
                 if (false && !datacomponentpatch.isEmpty()) { // Paper - This is no longer needed with raw NBT being handled in metadata
                     CraftItemStack.setItemMeta(itemstack, CraftItemStack.getItemMeta(itemstack));
                 }
+                // Kiterino start - Prevent creative from overriding items
+                if (me.sosedik.kiterino.KiterinoConfig.preventCreativeItemOverride) {
+                    net.minecraft.world.item.component.CustomData customData = itemstack.components.get(DataComponents.CUSTOM_DATA);
+                    if (customData != null && customData.contains("kiterino_og_item")) {
+                        Tag itemTag = customData.getUnsafe().get("kiterino_og_item");
+                        itemstack = parse(registryfriendlybytebuf.registryAccess(), itemTag).orElse(itemstack);
+                    }
+                }
+                // Kiterino end - Prevent creative from overriding items
                 return itemstack;
                 // CraftBukkit end
             }
@@ -183,6 +192,19 @@ public final class ItemStack implements DataComponentHolder {
                 // itemstack = itemstack.copy();
                 // CraftItemStack.setItemMeta(itemstack, CraftItemStack.getItemMeta(itemstack)); // Paper - This is no longer with raw NBT being handled in metadata
                 // Spigot end
+                // Kiterino start - Prevent creative from overriding items
+                net.minecraft.world.item.component.CustomData customData = null;
+                if (me.sosedik.kiterino.KiterinoConfig.preventCreativeItemOverride && !itemstack.isEmpty() && me.sosedik.kiterino.modifier.item.ItemModifiersHandlerImpl.modifiers.isEmpty()) {
+                    customData = itemstack.get(DataComponents.CUSTOM_DATA);
+                    if (customData == null) {
+                        customData = net.minecraft.world.item.component.CustomData.of(new CompoundTag());
+                        customData.getUnsafe().put("kiterino_og_item", itemstack.saveOptional(registryfriendlybytebuf.registryAccess()));
+                        itemstack.set(DataComponents.CUSTOM_DATA, customData);
+                    } else {
+                        customData.getUnsafe().put("kiterino_og_item", itemstack.saveOptional(registryfriendlybytebuf.registryAccess()));
+                    }
+                }
+                // Kiterino end - Prevent creative from overriding items
                 ITEM_STREAM_CODEC.encode(registryfriendlybytebuf, itemstack.getItemHolder()); // CraftBukkit - decompile error
                 // Paper start - adventure; conditionally render translatable components
                 boolean prev = net.minecraft.network.chat.ComponentSerialization.DONT_RENDER_TRANSLATABLES.get();
@@ -191,6 +213,15 @@ public final class ItemStack implements DataComponentHolder {
                 DataComponentPatch.STREAM_CODEC.encode(registryfriendlybytebuf, itemstack.components.asPatch());
                 } finally {
                     net.minecraft.network.chat.ComponentSerialization.DONT_RENDER_TRANSLATABLES.set(prev);
+                    // Kiterino start - Prevent creative from overriding items
+                    if (customData != null) {
+                        if (customData.getUnsafe().size() == 1) {
+                            itemstack.remove(DataComponents.CUSTOM_DATA);
+                        } else {
+                            customData.getUnsafe().remove("kiterino_og_item");
+                        }
+                    }
+                    // Kiterino end - Prevent creative from overriding items
                 }
                 // Paper end - adventure; conditionally render translatable components
             }
