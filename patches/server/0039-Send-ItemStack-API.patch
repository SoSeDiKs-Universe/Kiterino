From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Mon, 16 Sep 2024 18:02:03 +0300
Subject: [PATCH] Send ItemStack API


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 9d227820d2730b4b077a70f50a367afe9ce5b41e..3a5e70bf01b8ac865ff7fd591bf012cb586a16f9 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -3679,4 +3679,12 @@ public class CraftPlayer extends CraftHumanEntity implements Player {
         connection.send(new ClientboundSetBorderLerpSizePacket(20_000_00D, distance, 14_000L));
     }
     // Kiterino end - Red tint API
+
+    // Kiterino start - Send ItemStack API
+    @Override
+    public void sendItem(int slot, ItemStack item) {
+        int stateId = this.getHandle().containerMenu.getStateId();
+        this.getHandle().connection.send(new net.minecraft.network.protocol.game.ClientboundContainerSetSlotPacket(0, stateId, slot, CraftItemStack.asNMSCopy(item)));
+    }
+    // Kiterino end - Send ItemStack API
 }
