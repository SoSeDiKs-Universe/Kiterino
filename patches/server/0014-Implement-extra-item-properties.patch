From: SoSeDiK <mrsosedik@gmail.com>
Date: Thu, 16 May 2024 04:43:58 +0300
Subject: [PATCH] Implement extra item properties


diff --git a/src/main/java/me/sosedik/kiterino/util/KiterinoDataInjectorImpl.java b/src/main/java/me/sosedik/kiterino/util/KiterinoDataInjectorImpl.java
index d7e43bc7d872e4831baf86173e1b2dcf2f93568f..7564a6873554a3c6923849ceb7c893c321b8e9b2 100644
--- a/src/main/java/me/sosedik/kiterino/util/KiterinoDataInjectorImpl.java
+++ b/src/main/java/me/sosedik/kiterino/util/KiterinoDataInjectorImpl.java
@@ -10,6 +10,7 @@ import net.minecraft.core.component.DataComponents;
 import net.minecraft.resources.ResourceLocation;
 import net.minecraft.world.item.Item;
 import net.minecraft.world.item.Items;
+import net.minecraft.world.level.block.ComposterBlock;
 import org.bukkit.Material;
 import org.bukkit.craftbukkit.util.CraftMagicNumbers;
 import org.jetbrains.annotations.NotNull;
@@ -77,6 +78,9 @@ public class KiterinoDataInjectorImpl extends KiterinoDataInjector {
 	private void applyExtraItemProperties(@NotNull Item nmsItem, @Nullable KiterinoItemProperties properties) {
 		if (properties == null) return;
 
+		if (properties.getCompostChance() != null) {
+			ComposterBlock.add(properties.getCompostChance(), nmsItem);
+		}
 	}
 
 	private @NotNull Item createNmsItemClass(@NotNull ResourceLocation id, @NotNull KiterinoNMSItem item) throws Exception {
diff --git a/src/main/java/net/minecraft/world/level/block/ComposterBlock.java b/src/main/java/net/minecraft/world/level/block/ComposterBlock.java
index f34159f8d6c51af2341bf49db0d6d6f0417919cf..b56e5341a315cb746d4b589ccadbf0fac8d52329 100644
--- a/src/main/java/net/minecraft/world/level/block/ComposterBlock.java
+++ b/src/main/java/net/minecraft/world/level/block/ComposterBlock.java
@@ -181,7 +181,7 @@ public class ComposterBlock extends Block implements WorldlyContainerHolder {
         ComposterBlock.add(1.0F, Items.PUMPKIN_PIE);
     }
 
-    private static void add(float levelIncreaseChance, ItemLike item) {
+    public static void add(float levelIncreaseChance, ItemLike item) { // Kiterino - Implement extra item properties
         ComposterBlock.COMPOSTABLES.put(item.asItem(), levelIncreaseChance);
     }
 
