From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Thu, 20 Jun 2024 04:35:50 +0300
Subject: [PATCH] Expose canUseSlot


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
index 1504c8b0a36e1af7548b3b442e280e7c853e8028..65b46b42df6707b9da769c3ddc916f166cb17ca9 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
@@ -1194,4 +1194,11 @@ public class CraftLivingEntity extends CraftEntity implements LivingEntity {
         this.getHandle().setShouldBurnInDay(shouldBurnInDay);
     }
     // Purpur end - API for any mob to burn daylight
+
+    // Kiterino start - Expose canUseSlot
+    @Override
+    public boolean canUseSlot(org.bukkit.inventory.EquipmentSlot slot) {
+        return this.getHandle().canUseSlot(org.bukkit.craftbukkit.CraftEquipmentSlot.getNMS(slot));
+    }
+    // Kiterino end - Expose canUseSlot
 }
