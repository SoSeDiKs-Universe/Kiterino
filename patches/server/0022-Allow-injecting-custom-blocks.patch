 	public void injectItem(@NotNull Material material, @NotNull KiterinoNMSItem item) {
 		ResourceLocation id = PaperAdventure.asVanilla(material.getKey());
 		try {
+			if (item instanceof BlockItem nmsBlockItem) {
+				Block nmsBlock = nmsBlockItem.getBlock();
+				registerNMSBlock(id, nmsBlock);
+				registerNMSItem(material, id, nmsBlockItem);
+			} else if (item instanceof KiterinoBlockItem kiterinoBlockItem) {
+				KiterinoNMSBlock kiterinoNMSBlock = kiterinoBlockItem.getKiterinoBlock().get();
+				Block nmsBlock;
+				if (kiterinoNMSBlock instanceof Block block) {
+					nmsBlock = block;
+				} else if (kiterinoNMSBlock instanceof KiterinoBlock kiterinoBlock) {
+					nmsBlock = null; // TODO
+				} else {
+					throw new KiterinoDataInjectorRuntimeException("Unknown Kiterino block: " + id);
+				}
+				registerNMSBlock(id, nmsBlock);
+				Item nmsItem = createNmsBlockItemClass(id, nmsBlock, kiterinoBlockItem);
+				registerNMSItem(material, id, nmsItem);
