+	private static void registerNMSBlock(@NotNull ResourceLocation id, @NotNull Block block) {
+		Blocks.register(id.toString(), block);
+		for (BlockState blockState : block.getStateDefinition().getPossibleStates()) {
+			Block.BLOCK_STATE_REGISTRY.add(blockState);
+			blockState.initCache();
+		}
+		block.getLootTable(); // Init loot table
+	}
