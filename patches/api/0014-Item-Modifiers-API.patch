+package me.sosedik.kiterino.modifier.item;
+
+import me.sosedik.kiterino.modifier.item.context.ItemModifierContext;
+import me.sosedik.kiterino.modifier.item.context.ItemModifierContextType;
+import org.bukkit.NamespacedKey;
+import org.bukkit.entity.Player;
+import org.bukkit.inventory.ItemStack;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.Locale;
+
+/**
+ * Makes modifications to an item
+ */
+public abstract class ItemModifier {
+
+    private final NamespacedKey modifierId;
+
+    protected ItemModifier(@NotNull NamespacedKey modifierId) {
+        this.modifierId = modifierId;
+    }
+
+    /**
+     * Unique ID of this modifier
+     *
+     * @return modifier id
+     */
+    public @NotNull NamespacedKey getModifierId() {
+        return modifierId;
+    }
+
+    /**
+     * Registers this modifier
+     */
+    public void register() {
+        ItemModifiersHandler.itemModifiersHandler().registerModifier(this);
+    }
+
+    /**
+     * Unregisters this modifier
+     */
+    public void unregister() {
+        ItemModifiersHandler.itemModifiersHandler().unregisterModifier(this);
+    }
+
+    /**
+     * Whether this modifier should automatically
+     * skip air items
+     *
+     * @return whether to skip air items
+     */
+    public boolean skipAir() {
+        return true;
+    }
+
+    /**
+     * Whether this modifier should automatically
+     * skip the provided context
+     *
+     * @param contextType context type
+     * @return whether to skip context
+     */
+    public boolean skipContext(@NotNull ItemModifierContextType contextType) {
+        return false;
+    }
+
+    /**
+     * Modifies an item given the context
+     *
+     * @param contextBox item data
+     * @return modification result
+     */
+    public abstract @NotNull ModificationResult modify(@NotNull ItemContextBox contextBox);
+
+    /**
+     * Modify item with viewer's locale, empty context, lore and 0 slot.
+     * Will return {@code null} if no modifications were made.
+     *
+     * @param viewer player viewing the item
+     * @param item item
+     * @return modified item or {@code null}
+     */
+    public static @Nullable ItemStack modifyItem(@NotNull Player viewer, @NotNull ItemStack item) {
+        return modifyItem(viewer, viewer.locale(), item);
+    }
+
+    /**
+     * Modify item with empty context, lore and 0 slot
+     *
+     * @param viewer player viewing the item
+     * @param locale locale
+     * @param item item
+     * @return modified item or {@code null}
+     */
+    public static @Nullable ItemStack modifyItem(@Nullable Player viewer, @NotNull Locale locale, @NotNull ItemStack item) {
+        var contextBox = new ItemContextBox(viewer, locale, ItemModifierContextType.EMPTY_LORE, ItemModifierContext.EMPTY, item.clone());
+        return modifyItem(contextBox);
+    }
+
+    /**
+     * Modify item given the context.
+     * Will return {@code null} if no modifications were made.
+     *
+     * @param contextBox item context box
+     * @return modified item or {@code null}
+     */
+    public static @Nullable ItemStack modifyItem(@NotNull ItemContextBox contextBox) {
+        return ItemModifiersHandler.itemModifiersHandler().modifyItem(contextBox);
+    }
+
+}
diff --git a/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandler.java b/src/main/java/me/sosedik/kiterino/modifier/item/ItemModifiersHandler.java
