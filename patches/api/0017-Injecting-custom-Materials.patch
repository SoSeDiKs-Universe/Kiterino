@@ -4621,6 +4621,7 @@ public enum Material implements Keyed, Translatable, net.kyori.adventure.transla
     public final Class<?> data;
     private final boolean legacy;
     private final NamespacedKey key;
+    private final boolean injected = false; // Kiterino - Injecting custom Materials
 
     private Material(final int id) {
         this(id, 64);
@@ -4964,6 +4965,11 @@ public enum Material implements Keyed, Translatable, net.kyori.adventure.transla
         if (filtered.startsWith(NamespacedKey.MINECRAFT + ":")) {
             filtered = filtered.substring((NamespacedKey.MINECRAFT + ":").length());
         }
+        // Kiterino start - Injecting custom Materials
+        else {
+            filtered = filtered.replace(':', '_');
+        }
+        // Kiterino end - Injecting custom Materials
 
         filtered = filtered.toUpperCase(Locale.ROOT);
 
@@ -5659,4 +5665,16 @@ public enum Material implements Keyed, Translatable, net.kyori.adventure.transla
         }
     }
     // Purpur end
+
+    // Kiterino start - Injecting custom Materials
+    /**
+     * Checks whether this item is injected
+     * (i.e. non-vanilla one)
+     *
+     * @return whether this item is injected
+     */
+    public boolean isInjected() {
+        return this.injected;
+    }
+    // Kiterino end - Injecting custom Materials
 }
