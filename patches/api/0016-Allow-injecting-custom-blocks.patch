From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Fri, 17 May 2024 15:41:31 +0300
Subject: [PATCH] Allow injecting custom blocks


diff --git a/src/main/java/me/sosedik/kiterino/world/block/KiterinoBlock.java b/src/main/java/me/sosedik/kiterino/world/block/KiterinoBlock.java
new file mode 100644
index 0000000000000000000000000000000000000000..7c37c77bd6ace11e642caabec17977f195bde924
--- /dev/null
+++ b/src/main/java/me/sosedik/kiterino/world/block/KiterinoBlock.java
@@ -0,0 +1,11 @@
+package me.sosedik.kiterino.world.block;
+
+/**
+ * Represents a custom Kiterino block.
+ * <p>The block can be further extended by implementing specific behaviours:
+ * <ul>
+ * </ul>
+ */
+public interface KiterinoBlock extends KiterinoNMSBlock {
+
+}
diff --git a/src/main/java/me/sosedik/kiterino/world/block/KiterinoNMSBlock.java b/src/main/java/me/sosedik/kiterino/world/block/KiterinoNMSBlock.java
new file mode 100644
index 0000000000000000000000000000000000000000..c10dc89a7d9ef86173787e80e0342147003103f5
--- /dev/null
+++ b/src/main/java/me/sosedik/kiterino/world/block/KiterinoNMSBlock.java
@@ -0,0 +1,25 @@
+package me.sosedik.kiterino.world.block;
+
+import org.bukkit.block.BlockState;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Represents Kiterino NMS block.
+ * Extend this class with your NMS block to use it with
+ * Kiterino registry methods.
+ */
+public interface KiterinoNMSBlock {
+
+	/**
+	 * Gets custom block before used for sending to the client.
+	 * <p>If the resulting block state is null, you MUST
+	 * replace the block in some other way, e.g. via
+	 * packet listener plugins.
+	 * <p>Note: this will be called for each serialization, so
+	 * caching the block state is highly preferable.
+	 *
+	 * @return faked client block state
+	 */
+	@Nullable BlockState getClientBlockState();
+
+}
diff --git a/src/main/java/me/sosedik/kiterino/world/item/KiterinoBlockItem.java b/src/main/java/me/sosedik/kiterino/world/item/KiterinoBlockItem.java
new file mode 100644
index 0000000000000000000000000000000000000000..adddc66c9bcfaedb2d771aff1b4f1cac65fb3ac7
--- /dev/null
+++ b/src/main/java/me/sosedik/kiterino/world/item/KiterinoBlockItem.java
@@ -0,0 +1,27 @@
+package me.sosedik.kiterino.world.item;
+
+import me.sosedik.kiterino.world.block.KiterinoBlock;
+import me.sosedik.kiterino.world.block.KiterinoNMSBlock;
+import org.jetbrains.annotations.ApiStatus;
+import org.jetbrains.annotations.NotNull;
+
+import java.util.function.Supplier;
+
+/**
+ * Represents wrapped Kiterino block item
+ */
+public interface KiterinoBlockItem extends KiterinoItem {
+
+	/**
+	 * Returns NMS block. Can either be a direct NMS block,
+	 * or a {@link KiterinoBlock}.
+	 * <p>This method will be called only once by the server, so
+	 * it should be safe to simply return a new instance of NMS
+	 * block without storing it somewhere.
+	 *
+	 * @return nms block wrapper
+	 */
+	@ApiStatus.Internal
+	@NotNull Supplier<@NotNull KiterinoNMSBlock> getKiterinoBlock();
+
+}
