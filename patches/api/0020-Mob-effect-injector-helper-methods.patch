From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Tue, 9 Jul 2024 19:12:47 +0300
Subject: [PATCH] Mob effect injector helper methods


diff --git a/src/main/java/io/papermc/paper/plugin/bootstrap/BootstrapContext.java b/src/main/java/io/papermc/paper/plugin/bootstrap/BootstrapContext.java
index 4ebcc403159f6ce70d42f5b7801e6f9b20619764..f003ddb7d2b621d55e699c33bce761f03b2766a6 100644
--- a/src/main/java/io/papermc/paper/plugin/bootstrap/BootstrapContext.java
+++ b/src/main/java/io/papermc/paper/plugin/bootstrap/BootstrapContext.java
@@ -45,4 +45,26 @@ public interface BootstrapContext extends PluginProviderContext, LifecycleEventO
         me.sosedik.kiterino.util.KiterinoBootstrapMaterialInjector.injectMaterials(materialsClass, namespace);
     }
     // Kiterino end - Material injector helper methods
+
+    // Kiterino start - Mob effect injector helper methods
+    /**
+     * Inject mob effects in the class using the plugin's name as namespace.
+     * Keys will be fetched from PotionEffectType field names.
+     *
+     * @param mobEffectsClass  class with public static final {@link org.bukkit.potion.PotionEffectType} instances
+     */
+    default void injectMobEffects(@NotNull Class<?> mobEffectsClass) {
+        me.sosedik.kiterino.util.KiterinoBootstrapMobEffectInjector.injectMobEffects(mobEffectsClass, this);
+    }
+    /**
+     * Inject mob effects in the class using the provided namespace.
+     * Keys will be fetched from PotionEffectType field names.
+     *
+     * @param mobEffectsClass  class with public static final {@link org.bukkit.potion.PotionEffectType} instances
+     * @param namespace namespace for mob effects
+     */
+    default void injectMobEffects(@NotNull Class<?> mobEffectsClass, @NotNull String namespace) {
+        me.sosedik.kiterino.util.KiterinoBootstrapMobEffectInjector.injectMobEffects(mobEffectsClass, namespace);
+    }
+    // Kiterino end - Mob effect injector helper methods
 }
