From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Wed, 24 May 2023 17:13:26 +0300
Subject: [PATCH] Add manual panic mode


diff --git a/src/main/java/org/bukkit/entity/Entity.java b/src/main/java/org/bukkit/entity/Entity.java
index 1eb3a3cba077e1bf648c75f4589a3d5cc11332a0..a603fd958ba56afab8a288641df7c956a1af79bd 100644
--- a/src/main/java/org/bukkit/entity/Entity.java
+++ b/src/main/java/org/bukkit/entity/Entity.java
@@ -1442,4 +1442,20 @@ public interface Entity extends Metadatable, CommandSender, Nameable, Persistent
     @Nullable
     UUID getSpawningPlayerUuid();
     // Kiterino end - Spawning player API
+
+    // Kiterino start - Add manual panic mode
+    /**
+     * Gets the amount of manually set panic ticks left
+     *
+     * @return the amount of panic ticks
+     */
+    int getPanicTicks();
+
+    /**
+     * Sets the amount of panic ticks
+     *
+     * @param ticks ticks
+     */
+    void setPanicTicks(int ticks);
+    // Kiterino end - Add manual panic mode
 }
