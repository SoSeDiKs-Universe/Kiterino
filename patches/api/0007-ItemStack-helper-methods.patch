diff --git a/src/main/java/org/bukkit/inventory/ItemStack.java b/src/main/java/org/bukkit/inventory/ItemStack.java
index 44a26a768c11f60241010391211a19f6b589f23c..2a0839b0faf54b5a4824d8538035f1ec041563c8 100644
--- a/src/main/java/org/bukkit/inventory/ItemStack.java
+++ b/src/main/java/org/bukkit/inventory/ItemStack.java
@@ -1695,4 +1695,54 @@ public class ItemStack implements Cloneable, ConfigurationSerializable, Translat
         return random.nextInt(unbreaking + 1) > 0;
     }
     // Purpur end
+
+    // Kiterino start - ItemStack helper methods
+    /**
+     * Returns clone of this item with colored
+     * {@link org.bukkit.inventory.meta.LeatherArmorMeta} or {@link org.bukkit.inventory.meta.PotionMeta}.
+     *
+     * @param color color
+     * @return cloned colored item
+     */
+    public @NotNull ItemStack withColor(@NotNull net.kyori.adventure.util.RGBLike color) {
+        ItemStack clone = clone();
+        org.bukkit.Color _color = switch (color) {
+            case org.bukkit.Color bukkitColor -> bukkitColor;
+            case org.bukkit.DyeColor dyeColor -> dyeColor.getColor();
+            default -> org.bukkit.Color.fromRGB(color.red(), color.green(), color.blue());
+        };
+        ItemMeta meta = clone.getItemMeta();
+        if (meta instanceof org.bukkit.inventory.meta.LeatherArmorMeta leatherMeta) {
+            leatherMeta.setColor(_color);
+            clone.setItemMeta(leatherMeta);
+        } else if (meta instanceof org.bukkit.inventory.meta.PotionMeta potionMeta) {
+            potionMeta.setColor(_color);
+            clone.setItemMeta(potionMeta);
+        }
+        return clone;
+    }
+
+    /**
+     * Checks whether the item is null, air, or has amount equal to 0
+     *
+     * @param item item to check
+     * @return whether item is empty
+     */
+    @org.jetbrains.annotations.Contract("null -> true")
+    public static boolean isEmpty(@Nullable ItemStack item) {
+        return item == null || item.getType() == Material.AIR || item.getAmount() <= 0;
+    }
+
+    /**
+     * Checks whether the item is not empty and has the provided {@link Material}
+     *
+     * @param item item to check
+     * @param type required type
+     * @return whether the item has the same type
+     */
+    @org.jetbrains.annotations.Contract("null, _ -> false")
+    public static boolean isType(@Nullable ItemStack item, @NotNull Material type) {
+        return item != null && item.getType() == type && item.getAmount() > 0;
+    }
+    // Kiterino end - ItemStack helper methods
 }
