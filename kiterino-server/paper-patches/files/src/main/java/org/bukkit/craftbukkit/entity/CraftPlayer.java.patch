+    // Kiterino start - Red tint API
+    @Override
+    public void sendRedTint(double percentage) {
+        percentage = 1D - Math.clamp(percentage, 0D, 1D);
+        Location loc = this.getLocation();
+        ServerGamePacketListenerImpl connection = this.getHandle().connection;
+        connection.send(new ClientboundSetBorderCenterPacket(loc.getX(), loc.getZ()));
+
+        double distance = 13_000_000 - 10_000_000 * percentage;
+        connection.send(new ClientboundSetBorderLerpSizePacket(20_000_00D, distance, 14_000L));
+    }
