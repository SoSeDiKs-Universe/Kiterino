+    private boolean placeBlock(EquipmentSlot hand, ItemStack block, Location location, org.bukkit.block.BlockFace blockFace, boolean consume) {
+        if (block == null) {
+            return false;
+        }
+        if (!block.getType().isBlock()) {
+            return false;
+        }
+
+        var nmsItem = CraftItemStack.asNMSCopy(block);
+        var mop = new net.minecraft.world.phys.BlockHitResult(CraftLocation.toVec3(location), com.google.common.base.Enums.getIfPresent(net.minecraft.core.Direction.class, blockFace.toString()).or(net.minecraft.core.Direction.UP), CraftLocation.toBlockPos(location), false);
+        var context = new net.minecraft.world.item.context.BlockPlaceContext(getHandle(), CraftEquipmentSlot.getHand(hand), nmsItem, mop);
+        var result = nmsItem.useOn(context);
+        if (!(result instanceof net.minecraft.world.InteractionResult.Success)) {
+            return false;
+        }
+
+        swingHand(hand);
+        getWorld().playSound(location, location.getBlock().getBlockData().getSoundGroup().getPlaceSound(), 1F, 1F);
+        if (consume && getGameMode() != GameMode.CREATIVE) {
+            block.subtract();
+        }
+
+        return true;
+    }
