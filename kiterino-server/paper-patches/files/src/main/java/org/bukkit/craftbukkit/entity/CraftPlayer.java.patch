+    // Kiterino start - Block place API
+    @Override
+    public boolean placeBlock(EquipmentSlot hand, Location location, org.bukkit.block.BlockFace blockFace, boolean consume) {
+        return placeBlock(hand, getInventory().getItem(hand), location, blockFace, consume);
+    }
+
+    @Override
+    public boolean placeBlock(ItemStack block, Location location, org.bukkit.block.BlockFace blockFace, boolean consume) {
+        return placeBlock(EquipmentSlot.HAND, block, location, blockFace, consume);
+    }
+
+    private boolean placeBlock(EquipmentSlot hand, ItemStack block, Location location, org.bukkit.block.BlockFace blockFace, boolean consume) {
+        if (block == null) return false;
+        if (!block.getType().isBlock()) return false;
+
+        var nmsItem = CraftItemStack.asNMSCopy(block);
+        var pos = new BlockPos(location.getBlockX(), location.getBlockY(), location.getBlockZ());
+        var mop = new net.minecraft.world.phys.BlockHitResult(new net.minecraft.world.phys.Vec3(location.getX(), location.getY(), location.getZ()), com.google.common.base.Enums.getIfPresent(net.minecraft.core.Direction.class, blockFace.toString()).or(net.minecraft.core.Direction.UP), pos, false);
+
+        var interactionHand = hand == EquipmentSlot.OFF_HAND ? net.minecraft.world.InteractionHand.OFF_HAND : net.minecraft.world.InteractionHand.MAIN_HAND;
+        var result = nmsItem.useOn(new net.minecraft.world.item.context.BlockPlaceContext(getHandle(), interactionHand, nmsItem, mop));
+        if (!(result instanceof net.minecraft.world.InteractionResult.Success)) return false;
+
+        swingHand(hand);
+        getWorld().playSound(location, location.getBlock().getBlockData().getSoundGroup().getPlaceSound(), 1F, 1F);
+        if (consume && getGameMode() != GameMode.CREATIVE) block.subtract();
+
+        return true;
+    }
+    // Kiterino end - Block place API
