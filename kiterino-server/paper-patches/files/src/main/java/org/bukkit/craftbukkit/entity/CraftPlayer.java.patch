+    @Override
+    public BlockData getPlacedState(EquipmentSlot hand, ItemStack block, Location location, org.bukkit.block.BlockFace blockFace) {
+        net.minecraft.world.level.block.state.BlockState placedState = getPlacedState0(hand, block, location, blockFace);
+        return placedState == null ? null : placedState.asBlockData();
+    }
+
+    private net.minecraft.world.level.block.state.BlockState getPlacedState0(EquipmentSlot hand, ItemStack block, Location location, org.bukkit.block.BlockFace blockFace) {
+        if (block == null) {
+            return null;
+        }
+        if (!block.getType().isBlock()) {
+            return null;
+        }
+        if (!(location.getWorld() instanceof CraftWorld craftWorld)) {
+            return null;
+        }
+
+        var nmsItem = CraftItemStack.asNMSCopy(block);
+        if (!(nmsItem.getItem() instanceof net.minecraft.world.item.BlockItem blockItem)) {
+            return null;
+        }
+
+        BlockPos blockPos = CraftLocation.toBlockPos(location);
+        var mop = new net.minecraft.world.phys.BlockHitResult(CraftLocation.toVec3(location), com.google.common.base.Enums.getIfPresent(net.minecraft.core.Direction.class, blockFace.toString()).or(net.minecraft.core.Direction.UP), blockPos, false);
+        var context = new net.minecraft.world.item.context.BlockPlaceContext(getHandle(), CraftEquipmentSlot.getHand(hand), nmsItem, mop);
+
+        if (!craftWorld.getHandle().getBlockState(blockPos).canBeReplaced(context)) {
+            return null;
+        }
+
+        return blockItem.getPlacementState(context);
+    }
+
