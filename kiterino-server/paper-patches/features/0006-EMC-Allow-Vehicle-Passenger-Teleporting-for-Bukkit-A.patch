+            entity.connection.teleport(location);
+        } else {
+            server.getHandle().respawn(entity, true, Entity.RemovalReason.CHANGED_DIMENSION, null, location);
+        }
+    }
+    // Kiterino end - EMC - Vehicle passenger teleporting
