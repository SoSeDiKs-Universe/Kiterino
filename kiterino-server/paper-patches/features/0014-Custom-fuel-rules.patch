@@ -1516,6 +1516,13 @@ public final class CraftServer implements Server {
     }
     // Purpur end - Added the ability to add combustible items
 
+    // Kiterino start - Custom fuel rules
+    @Override
+    public void addFuel(java.util.function.Function<ItemStack, Integer> rule) {
+        MinecraftServer.getServer().fuelValues().extraRules.add(rule);
+    }
+    // Kiterino end - Custom fuel rules
+
