@@ -2454,4 +2454,16 @@ public class CraftEventFactory {
         return event;
     }
     // Kiterino end - Paper PR - Add FillBottleEvents for player and dispenser
+
+    // Kiterino start - Paper PR - New and Improved Lidded API
+    public static boolean callPlayerLiddedOpenEvent(net.minecraft.world.entity.player.Player who, final Level level, final BlockPos pos) {
+        Player player = (Player) who.getBukkitEntity();
+        Block block = CraftBlock.at(level, pos);
+        io.papermc.paper.block.PaperLidded blockState = (io.papermc.paper.block.PaperLidded) CraftBlockStates.getBlockState(block);
+
+        var event = new io.papermc.paper.event.player.PlayerLiddedOpenEvent(player, blockState, block);
+
+        return event.callEvent();
+    }
+    // Kiterino end - Paper PR - New and Improved Lidded API
 }
