From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Wed, 29 Jan 2025 18:29:19 +0200
Subject: [PATCH] Better EntityShootBowEvent cancellation

Don't increase stats / play bow sound if event was cancelled

diff --git a/net/minecraft/world/item/BowItem.java b/net/minecraft/world/item/BowItem.java
index 3c0e02d46d5670d69d3338f0aadff54bc86035de..dbf3ce0750c5154fd9a0933c53c9dac827a650db 100644
--- a/net/minecraft/world/item/BowItem.java
+++ b/net/minecraft/world/item/BowItem.java
@@ -44,7 +44,7 @@ public class BowItem extends ProjectileWeaponItem {
 
             List<ItemStack> firedProjectiles = draw(itemStack, projectile, player, !projectile.has(net.minecraft.core.component.DataComponents.INTANGIBLE_PROJECTILE)); // Kiterino - Infinite projectiles
             if (level instanceof ServerLevel serverLevel && !firedProjectiles.isEmpty()) {
-                this.shoot(serverLevel, player, player.getUsedItemHand(), itemStack, firedProjectiles, pow * 3.0F, (float) serverLevel.purpurConfig.bowProjectileOffset, pow == 1.0F, null, pow); // Paper - Pass draw strength // Purpur - Projectile offset config
+	            if (!this.shoot(serverLevel, player, player.getUsedItemHand(), itemStack, firedProjectiles, pow * 3.0F, (float) serverLevel.purpurConfig.bowProjectileOffset, pow == 1.0F, null, pow)) return false; // Paper - Pass draw strength // Purpur - Projectile offset config // Kiterino - Better EntityShootBowEvent cancellation
             }
 
             level.playSound(
diff --git a/net/minecraft/world/item/CrossbowItem.java b/net/minecraft/world/item/CrossbowItem.java
index d54f67ac95b1f93ea6d3db10160c68def11acc4e..854708f28e0b63e0e374d587b587bef1575f5200 100644
--- a/net/minecraft/world/item/CrossbowItem.java
+++ b/net/minecraft/world/item/CrossbowItem.java
@@ -198,7 +198,7 @@ public class CrossbowItem extends ProjectileWeaponItem {
         if (level instanceof ServerLevel serverLevel) {
             ChargedProjectiles charged = weapon.set(DataComponents.CHARGED_PROJECTILES, ChargedProjectiles.EMPTY);
             if (charged != null && !charged.isEmpty()) {
-                this.shoot(serverLevel, shooter, hand, weapon, charged.itemCopies(), power, uncertainty, shooter instanceof Player, targetOverride, 1.0F); // Paper - Pass draw strength
+                if (!this.shoot(serverLevel, shooter, hand, weapon, charged.itemCopies(), power, uncertainty, shooter instanceof Player, targetOverride, 1.0F)) return; // Paper - Pass draw strength // Kiterino - Better EntityShootBowEvent cancellation
                 if (shooter instanceof ServerPlayer player) {
                     CriteriaTriggers.SHOT_CROSSBOW.trigger(player, weapon);
                     player.awardStat(Stats.ITEM_USED.get(weapon.getItem()));
diff --git a/net/minecraft/world/item/ProjectileWeaponItem.java b/net/minecraft/world/item/ProjectileWeaponItem.java
index 039fc3ced4e06a97346264b52375ddd298fb8422..d78ee648df7ebed9ada8f8f3b48e1586f2efb74d 100644
--- a/net/minecraft/world/item/ProjectileWeaponItem.java
+++ b/net/minecraft/world/item/ProjectileWeaponItem.java
@@ -40,7 +40,7 @@ public abstract class ProjectileWeaponItem extends Item {
 
     public abstract int getDefaultProjectileRange();
 
-    protected void shoot(
+    protected boolean shoot( // Kiterino - void -> boolean - Better EntityShootBowEvent cancellation
         final ServerLevel level,
         final LivingEntity shooter,
         final InteractionHand hand,
@@ -70,7 +70,7 @@ public abstract class ProjectileWeaponItem extends Item {
                 org.bukkit.event.entity.EntityShootBowEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callEntityShootBowEvent(shooter, weapon, projectile, projectileEntity, hand, drawStrength, true);
                 if (event.isCancelled()) {
                     event.getProjectile().remove();
-                    return;
+                    return false; // Kiterino - Better EntityShootBowEvent cancellation
                 }
 
                 if (event.getProjectile() == projectileEntity.getBukkitEntity()) {
@@ -79,7 +79,7 @@ public abstract class ProjectileWeaponItem extends Item {
                         level,
                         projectile
                     ).isRemoved()) {
-                        return;
+                        return false; // Kiterino - Better EntityShootBowEvent cancellation
                     }
                 }
                 // CraftBukkit end
@@ -89,6 +89,7 @@ public abstract class ProjectileWeaponItem extends Item {
                 }
             }
         }
+        return true; // Kiterino - Better EntityShootBowEvent cancellation
     }
 
     protected int getDurabilityUse(final ItemStack projectile) {
