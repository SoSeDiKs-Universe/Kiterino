From: SoSeDiK <mrsosedik@gmail.com>
Date: Sat, 13 Dec 2025 02:54:52 +0200
Subject: [PATCH] Change enabled experiments


diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index d59ccfab91841dc328c2bab587b3e2c16c228f24..eabc05d6ee64475f26ec175efff687ec7b583a38 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -440,6 +440,7 @@ public class Main {
             initMode = true;
             dataConfigToUse = new WorldDataConfiguration(properties.initialDataPackConfiguration, FeatureFlags.DEFAULT_FLAGS);
         }
+        dataConfigToUse = dataConfigToUse.expandFeatures(FeatureFlags.KITERINO_FLAGS); // Kiterino - Change enabled experiments
 
         WorldLoader.PackConfig packConfig = new WorldLoader.PackConfig(packRepository, dataConfigToUse, safeModeEnabled, initMode);
         return new WorldLoader.InitConfig(packConfig, Commands.CommandSelection.DEDICATED, properties.functionPermissions);
diff --git a/net/minecraft/world/flag/FeatureFlags.java b/net/minecraft/world/flag/FeatureFlags.java
index 24d84282947aaff29031bd37de06d80075db3362..298d4d69d9cee906a58208b6fc4c48e6ee8bc5f6 100644
--- a/net/minecraft/world/flag/FeatureFlags.java
+++ b/net/minecraft/world/flag/FeatureFlags.java
@@ -14,6 +14,7 @@ public class FeatureFlags {
     public static final Codec<FeatureFlagSet> CODEC;
     public static final FeatureFlagSet VANILLA_SET;
     public static final FeatureFlagSet DEFAULT_FLAGS;
+    public static final FeatureFlagSet KITERINO_FLAGS; // Kiterino - Change enabled experiments
 
     public static String printMissingFlags(final FeatureFlagSet allowedFlags, final FeatureFlagSet requestedFlags) {
         return printMissingFlags(REGISTRY, allowedFlags, requestedFlags);
@@ -39,5 +40,6 @@ public class FeatureFlags {
         CODEC = REGISTRY.codec();
         VANILLA_SET = FeatureFlagSet.of(VANILLA);
         DEFAULT_FLAGS = VANILLA_SET;
+        KITERINO_FLAGS = FeatureFlagSet.of(VANILLA, TRADE_REBALANCE, REDSTONE_EXPERIMENTS, MINECART_IMPROVEMENTS); // Kiterino - Change enabled experiments
     }
 }
