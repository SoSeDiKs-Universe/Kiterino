+                        if (bottleEvent.isCancelled()) {
+                            return dispensed;
+                        }
+                        // Kiterino end - Paper PR - Add FillBottleEvents for player and dispenser
                         this.setSuccess(true);
-                        return this.takeLiquid(source, dispensed, PotionContents.createItemStack(Items.POTION, Potions.WATER));
+                        return this.takeLiquid(source, dispensed, org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(bottleEvent.getResultItem())); // Kiterino - Paper PR - Add FillBottleEvents for player and dispenser
