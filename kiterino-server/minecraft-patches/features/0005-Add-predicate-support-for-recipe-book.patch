     public java.util.@org.jspecify.annotations.Nullable Set<ItemStack> itemStacks; // Paper - Improve exact choice recipe ingredients
-    public Predicate<org.bukkit.inventory.ItemStack> predicate; // Purpur - Add predicate to recipe's ExactChoice ingredient
+    public @org.jspecify.annotations.Nullable Predicate<org.bukkit.inventory.ItemStack> predicate; // Purpur - Add predicate to recipe's ExactChoice ingredient // Kiterino - Mark nullable - Add predicate support for the recipe book
 
     public boolean isExact() {
         return this.itemStacks != null;
@@ -83,7 +83,7 @@ public final class Ingredient implements Predicate<ItemStack>, StackedContents.I
     @Override
     public boolean test(final ItemStack input) {
         // CraftBukkit start
-        if (this.isExact()) {
+        if (this.predicate == null && this.isExact()) { // Kiterino - Add predicate support for the recipe book
             return this.itemStacks.contains(input); // Paper - Improve exact choice recipe ingredients (hashing FTW!)
         }
         // CraftBukkit end
@@ -101,15 +101,15 @@ public final class Ingredient implements Predicate<ItemStack>, StackedContents.I
         return switch (itemOrExact) {
             case io.papermc.paper.inventory.recipe.ItemOrExact.Item(final Holder<Item> item) ->
                 !this.isExact() && this.values.contains(item);
-            case io.papermc.paper.inventory.recipe.ItemOrExact.Exact(final ItemStack exact) ->
-                this.isExact() && this.itemStacks.contains(exact);
+            case io.papermc.paper.inventory.recipe.ItemOrExact.Exact(final ItemStack exact, java.util.function.@org.jspecify.annotations.Nullable Predicate<org.bukkit.inventory.ItemStack> p) -> // Kiterino - Add predicate support for the recipe book
+                this.predicate == null ? (this.isExact() && this.itemStacks.contains(exact)) : this.predicate.test(exact.asBukkitMirror()); // Kiterino - Add predicate support for the recipe book
         };
         // Paper end - Improve exact choice recipe ingredients
     }
 
     @Override
     public boolean equals(final Object o) {
-        return o instanceof Ingredient other && Objects.equals(this.values, other.values) && Objects.equals(this.itemStacks, other.itemStacks); // CraftBukkit
+        return o instanceof Ingredient other && Objects.equals(this.values, other.values) && Objects.equals(this.itemStacks, other.itemStacks) && Objects.equals(this.predicate, other.predicate); // CraftBukkit // Kiterino - Add predicate support for the recipe book
     }
 
     public static Ingredient of(final ItemLike itemLike) {
