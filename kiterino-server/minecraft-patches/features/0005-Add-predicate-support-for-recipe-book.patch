         };
         // Paper end - Improve exact choice recipe ingredients
     }
 
     @Override
     public boolean equals(Object other) {
-        return other instanceof Ingredient ingredient && Objects.equals(this.values, ingredient.values) && Objects.equals(this.itemStacks, ingredient.itemStacks); // CraftBukkit
+        return other instanceof Ingredient ingredient && Objects.equals(this.values, ingredient.values) && Objects.equals(this.itemStacks, ingredient.itemStacks) && Objects.equals(this.predicate, ingredient.predicate); // CraftBukkit // Kiterino - Add predicate support for the recipe book
     }
 
     public static Ingredient of(ItemLike item) {
