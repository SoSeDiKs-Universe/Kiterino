From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Fri, 20 Sep 2024 22:48:30 +0300
Subject: [PATCH] Add predicate support for recipe book

Allows using Purpur's ingredient predicate as a matcher for the recipe book.

Implementation details:
- Purpur's predicates do not check the item type, it's up to the developer.
- Vanilla limitations still apply: no damaged/enchanted/renamed items.

diff --git a/io/papermc/paper/inventory/recipe/ItemOrExact.java b/io/papermc/paper/inventory/recipe/ItemOrExact.java
index ce745e49cd54fe3ae187785563a1bd311d14b5b2..847ac1b6ee4fe2e6a84e2fd41034aa026834988c 100644
--- a/io/papermc/paper/inventory/recipe/ItemOrExact.java
+++ b/io/papermc/paper/inventory/recipe/ItemOrExact.java
@@ -3,6 +3,8 @@ package io.papermc.paper.inventory.recipe;
 import net.minecraft.core.Holder;
 import net.minecraft.world.item.ItemStack;
 
+import java.util.Objects;
+
 public sealed interface ItemOrExact permits ItemOrExact.Item, ItemOrExact.Exact {
 
     int getMaxStackSize();
@@ -37,7 +39,13 @@ public sealed interface ItemOrExact permits ItemOrExact.Item, ItemOrExact.Exact
         }
     }
 
-    record Exact(ItemStack stack) implements ItemOrExact {
+    record Exact(ItemStack stack, java.util.function.@org.jspecify.annotations.Nullable Predicate<org.bukkit.inventory.ItemStack> predicate) implements ItemOrExact { // Kiterino - Add predicate support for the recipe book
+
+        // Kiterino start - Add predicate support for the recipe book
+        public Exact(ItemStack stack) {
+            this(stack, null);
+        }
+        // Kiterino end - Add predicate support for the recipe book
 
         @Override
         public int getMaxStackSize() {
@@ -46,18 +54,19 @@ public sealed interface ItemOrExact permits ItemOrExact.Item, ItemOrExact.Exact
 
         @Override
         public boolean matches(final ItemStack stack) {
+            if (this.predicate != null) return this.predicate.test(stack.asBukkitMirror()); // Kiterino - Add predicate support for the recipe book
             return ItemStack.isSameItemSameComponents(this.stack, stack);
         }
 
         @Override
         public boolean equals(final Object obj) {
             if (!(obj instanceof final Exact otherExact)) return false;
-            return ItemStack.isSameItemSameComponents(this.stack, otherExact.stack);
+            return ItemStack.isSameItemSameComponents(this.stack, otherExact.stack) && java.util.Objects.equals(this.predicate, otherExact.predicate); // Kiterino - Add predicate support for the recipe book
         }
 
         @Override
         public int hashCode() {
-            return ItemStack.hashItemAndComponents(this.stack);
+            return ItemStack.hashItemAndComponents(this.stack) * 31 + Objects.hashCode(this.predicate); // Kiterino - Add predicate support for the recipe book
         }
     }
 }
diff --git a/io/papermc/paper/inventory/recipe/StackedContentsExtrasMap.java b/io/papermc/paper/inventory/recipe/StackedContentsExtrasMap.java
index f47c12e9dd6cfa857ca07a764edc22de372e25b6..487d3b3f25aa4c73d7e5d957b06a90c7df200ae5 100644
--- a/io/papermc/paper/inventory/recipe/StackedContentsExtrasMap.java
+++ b/io/papermc/paper/inventory/recipe/StackedContentsExtrasMap.java
@@ -16,6 +16,7 @@ public final class StackedContentsExtrasMap {
     private final StackedContents<ItemOrExact> contents;
     public Object2IntMap<ItemOrExact.Item> regularRemoved = new Object2IntOpenHashMap<>(); // needed for re-using the regular contents (for ShapelessRecipe)
     public final ObjectSet<ItemStack> exactIngredients = new ObjectOpenCustomHashSet<>(ItemStackLinkedSet.TYPE_AND_TAG);
+    public final java.util.Map<ItemStack, java.util.function.Predicate<org.bukkit.inventory.ItemStack>> predicateIngredients = new java.util.HashMap<>(); // Kiterino - Add predicate support for the recipe book
 
     public StackedContentsExtrasMap(final StackedContents<ItemOrExact> contents) {
         this.contents = contents;
@@ -23,7 +24,13 @@ public final class StackedContentsExtrasMap {
 
     public void initialize(final Recipe<?> recipe) {
         this.exactIngredients.clear();
+        this.predicateIngredients.clear(); // Kiterino - Add predicate support for the recipe book
         for (final Ingredient ingredient : recipe.placementInfo().ingredients()) {
+            // Kiterino start - Add predicate support for the recipe book
+            if (ingredient.predicate != null) {
+                ingredient.itemStacks().forEach(item -> this.predicateIngredients.put(item, ingredient.predicate));
+            }
+            // Kiterino end - Add predicate support for the recipe book
             if (ingredient.isExact()) {
                 this.exactIngredients.addAll(ingredient.itemStacks());
             }
@@ -49,18 +56,33 @@ public final class StackedContentsExtrasMap {
     public void resetExtras() {
         // clear previous extra ids
         for (final ItemStack extra : this.exactIngredients) {
-            this.contents.amounts.removeInt(new ItemOrExact.Exact(extra));
+            this.contents.amounts.removeInt(new ItemOrExact.Exact(extra, this.predicateIngredients.get(extra))); // Kiterino - Add predicate support for the recipe book
         }
         for (final Object2IntMap.Entry<ItemOrExact.Item> entry : this.regularRemoved.object2IntEntrySet()) {
             this.contents.amounts.addTo(entry.getKey(), entry.getIntValue());
         }
         this.exactIngredients.clear();
+        this.predicateIngredients.clear(); // Kiterino - Add predicate support for the recipe book
         this.regularRemoved.clear();
     }
 
     public boolean accountStack(final ItemStack stack, final int count) {
-        if (this.exactIngredients.contains(stack)) {
-            this.contents.account(new ItemOrExact.Exact(stack), count);
+        // Kiterino start - Add predicate support for the recipe book
+        java.util.function.Predicate<org.bukkit.inventory.ItemStack> predicate = this.predicateIngredients.get(stack);
+        if (predicate != null && !predicate.test(stack.asBukkitMirror())) {
+            return false;
+        }
+        if (predicate == null) {
+            for (java.util.function.Predicate<org.bukkit.inventory.ItemStack> p : this.predicateIngredients.values()) {
+                if (p.test(stack.asBukkitMirror())) {
+                    predicate = p;
+                    break;
+                }
+            }
+        }
+        if (predicate != null || this.exactIngredients.contains(stack)) {
+            this.contents.account(new ItemOrExact.Exact(stack, predicate), count);
+            // Kiterino end - Add predicate support for the recipe book
             return true;
         }
         return false;
diff --git a/net/minecraft/world/entity/player/StackedItemContents.java b/net/minecraft/world/entity/player/StackedItemContents.java
