         if (!itemStack.isEmpty()) {
             int count = Math.min(maxCount, itemStack.getCount());
-            if (this.extrasMap != null && !itemStack.getComponentsPatch().isEmpty() && this.extrasMap.accountStack(itemStack, count)) return; // Paper - Improve exact choice recipe ingredients; if an exact ingredient, don't include it
+            if (this.extrasMap != null /*&& !itemStack.getComponentsPatch().isEmpty() */&& this.extrasMap.accountStack(itemStack, count)) return; // Paper - Improve exact choice recipe ingredients; if an exact ingredient, don't include it // Kiterino - Add predicate support for the recipe book
             this.raw.account(new io.papermc.paper.inventory.recipe.ItemOrExact.Item(itemStack.typeHolder()), count);
         }
     }
diff --git a/net/minecraft/world/item/crafting/Ingredient.java b/net/minecraft/world/item/crafting/Ingredient.java
index 32d5829f605357b83ff559b5f298faba00f5b53e..e8122350f22fa9e27d9649c0cbf21c08363b8f82 100644
