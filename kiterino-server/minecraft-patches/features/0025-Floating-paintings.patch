From: SoSeDiK <mrsosedik@gmail.com>
Date: Sat, 7 Feb 2026 14:48:26 +0200
Subject: [PATCH] Floating paintings


diff --git a/net/minecraft/world/entity/decoration/painting/Painting.java b/net/minecraft/world/entity/decoration/painting/Painting.java
index 6a3170060fdc4df3039cffbb2887918e214c28d9..67e853146b4171c4b36a1fd2997e97a2f5a39f62 100644
--- a/net/minecraft/world/entity/decoration/painting/Painting.java
+++ b/net/minecraft/world/entity/decoration/painting/Painting.java
@@ -46,6 +46,30 @@ public class Painting extends HangingEntity {
         super(type, level);
     }
 
+    // Kiterino start - Floating paintings
+    @Override
+    public boolean survives() {
+        if (level().kiterinoConfig.floatingPaintings) {
+            return canCoexist(true);
+        }
+        return super.survives();
+    }
+
+    public boolean canBePlaced(boolean requireSupport) {
+        if (!level().kiterinoConfig.floatingPaintings) {
+            return survives();
+        }
+        if (hasLevelCollision(getPopBox())) {
+            return false;
+        }
+        boolean flag = !requireSupport || BlockPos.betweenClosedStream(this.calculateSupportBox()).allMatch(blockPos -> {
+	        net.minecraft.world.level.block.state.BlockState blockState = this.level().getBlockState(blockPos);
+	        return !blockState.isAir();
+        });
+        return flag && canCoexist(true);
+    }
+    // Kiterino end - Floating paintings
+
     @Override
     protected void defineSynchedData(final SynchedEntityData.Builder entityData) {
         super.defineSynchedData(entityData);
@@ -99,7 +123,7 @@ public class Painting extends HangingEntity {
             candidate.setDirection(direction);
             potentialVariants.removeIf(variant -> {
                 candidate.setVariant((Holder<PaintingVariant>)variant);
-                return !candidate.survives();
+                return !candidate.canBePlaced(true); // Kiterino - Floating paintings
             });
             if (potentialVariants.isEmpty()) {
                 return Optional.empty();
diff --git a/net/minecraft/world/item/HangingEntityItem.java b/net/minecraft/world/item/HangingEntityItem.java
index c07b334eb05fd277925b684256591d505e5fd46a..f4a67a8f087c387105720c091444864c060b841e 100644
--- a/net/minecraft/world/item/HangingEntityItem.java
+++ b/net/minecraft/world/item/HangingEntityItem.java
@@ -82,6 +82,11 @@ public class HangingEntityItem extends Item {
                 }
 
                 itemInHand.shrink(1);
+                // Kiterino start - Floating paintings
+                if (player != null && context.getLevel().kiterinoConfig.floatingPaintings) {
+                    player.swing(context.getHand(), true);
+                }
+                // Kiterino end - Floating paintings
                 return InteractionResult.SUCCESS;
             } else {
                 return InteractionResult.CONSUME;
