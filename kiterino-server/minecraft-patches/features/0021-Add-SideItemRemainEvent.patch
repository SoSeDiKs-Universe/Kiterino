From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Wed, 19 Nov 2025 00:14:30 +0200
Subject: [PATCH] Add SideItemRemainEvent


diff --git a/net/minecraft/world/item/crafting/CraftingRecipe.java b/net/minecraft/world/item/crafting/CraftingRecipe.java
index 6fbcac0adbc452482a40341fcf94c4d63666bdab..912339a41a3667cac3bc9f687a7e4ab00fbd9a5f 100644
--- a/net/minecraft/world/item/crafting/CraftingRecipe.java
+++ b/net/minecraft/world/item/crafting/CraftingRecipe.java
@@ -29,7 +29,11 @@ public interface CraftingRecipe extends Recipe<CraftingInput> {
         for (int slot = 0; slot < result.size(); slot++) {
             Item item = input.getItem(slot).getItem();
             ItemStackTemplate remainder = item.getCraftingRemainder();
-            result.set(slot, remainder != null ? remainder.create() : ItemStack.EMPTY);
+            // Kiterino start - Add SideItemRemainEvent
+            var event = new me.sosedik.kiterino.event.item.SideItemRemainEvent(me.sosedik.kiterino.event.item.SideItemRemainEvent.Reason.CRAFTING_REMAINDER, input.getItem(slot).asBukkitCopy(), remainder == null ? org.bukkit.inventory.ItemStack.empty() : remainder.create().asBukkitCopy());
+            event.callEvent();
+            result.set(slot, ItemStack.fromBukkitCopy(event.getRemainder()));
+            // Kiterino end - Add SideItemRemainEvent
         }
 
         return result;
diff --git a/net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java b/net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java
index db11959c45931b44ff60c7d6cbc5500e7ea6d11a..aab3af5528884bd1cf6b708a79b85e9d29dbb1ff 100644
--- a/net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java
@@ -363,7 +363,14 @@ public abstract class AbstractFurnaceBlockEntity extends BaseContainerBlockEntit
         // CraftBukkit end
 
         if (inputItemStack.is(Items.WET_SPONGE) && !items.get(1).isEmpty() && items.get(1).is(Items.BUCKET)) {
-            items.set(1, new ItemStack(Items.WATER_BUCKET));
+            // Kiterino start - Add SideItemRemainEvent
+            var event = new me.sosedik.kiterino.event.item.SideItemRemainEvent(me.sosedik.kiterino.event.item.SideItemRemainEvent.Reason.WET_SPONGE, items.get(1).asBukkitCopy(), new ItemStack(Items.WATER_BUCKET).asBukkitMirror());
+            event.callEvent();
+            var bukkitItem = event.getRemainder();
+            if (!bukkitItem.isEmpty()) {
+                items.set(1, ItemStack.fromBukkitCopy(bukkitItem));
+            }
+            // Kiterino end - Add SideItemRemainEvent
         }
 
         inputItemStack.shrink(1);
