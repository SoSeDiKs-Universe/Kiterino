From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Sun, 16 Nov 2025 23:45:31 +0200
Subject: [PATCH] Extra bucketable mobs


diff --git a/net/minecraft/core/dispenser/DispenseItemBehavior.java b/net/minecraft/core/dispenser/DispenseItemBehavior.java
index 2a03093f8fe465076747fddc1b615d3d7154e801..02910a75b45e2d778174039698f928ebaca44aa8 100644
--- a/net/minecraft/core/dispenser/DispenseItemBehavior.java
+++ b/net/minecraft/core/dispenser/DispenseItemBehavior.java
@@ -204,7 +204,8 @@ public interface DispenseItemBehavior {
                 /* Taken from BucketItem#emptyContents */
                 boolean willEmptyBucketItem = bucket instanceof final net.minecraft.world.item.BucketItem bucketItem && bucketItem.getContent() instanceof net.minecraft.world.level.material.FlowingFluid && (state.isAir() || state.canBeReplaced(bucketItem.getContent()) || (state.getBlock() instanceof net.minecraft.world.level.block.LiquidBlockContainer liquidBlockContainer && liquidBlockContainer.canPlaceLiquid(null, level, target, state, bucketItem.getContent())));
                 ItemStack leftover = new ItemStack(Items.BUCKET); // Kiterino - More BlockDispenseEvent API
-                if (willEmptyContentsSolidBucketItem || willEmptyBucketItem) {
+                boolean willPlaceCustomMob = bucket instanceof net.minecraft.world.item.MobBucketItem bucketItem && bucketItem.getContent() == net.minecraft.world.level.material.Fluids.EMPTY; // Kiterino - Extra bucketable mobs
+                if (willEmptyContentsSolidBucketItem || willEmptyBucketItem || willPlaceCustomMob) { // Kiterino - Extra bucketable mobs
                 // Paper end - correctly check if the bucket place will succeed
                     org.bukkit.block.Block block = org.bukkit.craftbukkit.block.CraftBlock.at(level, source.pos());
                     org.bukkit.craftbukkit.inventory.CraftItemStack craftItem = org.bukkit.craftbukkit.inventory.CraftItemStack.asCraftMirror(dispensed.copyWithCount(1)); // Paper - single item in event
@@ -247,6 +248,7 @@ public interface DispenseItemBehavior {
                 }
             }
         };
+        net.minecraft.world.item.MobBucketItem.BUCKET_DISPENSE_BEHAVIOR = filledBucketBehavior; // Kiterino - Extra bucketable mobs
         DispenserBlock.registerBehavior(Items.LAVA_BUCKET, filledBucketBehavior);
         DispenserBlock.registerBehavior(Items.WATER_BUCKET, filledBucketBehavior);
         DispenserBlock.registerBehavior(Items.POWDER_SNOW_BUCKET, filledBucketBehavior);
diff --git a/net/minecraft/world/entity/Bucketable.java b/net/minecraft/world/entity/Bucketable.java
index c0a931526bf663da06949fbe0a4a19ba5ecc5838..1c471a7266b0146d6a85fa8995fd638325dd7ddb 100644
--- a/net/minecraft/world/entity/Bucketable.java
+++ b/net/minecraft/world/entity/Bucketable.java
@@ -28,6 +28,24 @@ public interface Bucketable {
 
     SoundEvent getPickupSound();
 
+    // Kiterino start - Extra bucketable mobs
+    default net.minecraft.world.item.Item getPickBucket() {
+        return Items.WATER_BUCKET;
+    }
+
+    default boolean canPickup(LivingEntity entity) {
+        return true;
+    }
+
+    default void saveToBucketTag(LivingEntity entity, ItemStack stack) {
+        saveToBucketTag(stack);
+    }
+
+    default void loadFromBucketTag(LivingEntity entity, CompoundTag tag) {
+        loadFromBucketTag(tag);
+    }
+    // Kiterino end - Extra bucketable mobs
+
     @Deprecated
     static void saveDefaultDataToBucketTag(final Mob entity, final ItemStack bucket) {
         bucket.copyFrom(DataComponents.CUSTOM_NAME, entity);
@@ -75,15 +93,34 @@ public interface Bucketable {
         tag.getFloat("Health").ifPresent(entity::setHealth);
     }
 
-    static <T extends LivingEntity & Bucketable> Optional<InteractionResult> bucketMobPickup(
+    static <T extends LivingEntity> Optional<InteractionResult> bucketMobPickup( // Kiterino - Extra bucketable mobs
         final Player player, final InteractionHand hand, final T pickupEntity
     ) {
         ItemStack itemStack = player.getItemInHand(hand);
-        if (pickupEntity.canBePickedUpWithBucket(itemStack) && pickupEntity.isAlive()) {
+        // Kiterino start - Extra bucketable mobs
+        java.util.List<Bucketable> bucketables = net.minecraft.world.item.MobBucketItem.EXTRA_BUCKETABLE_RULES.get(pickupEntity.getType());
+        if (bucketables == null) {
+            if (pickupEntity instanceof Bucketable bucketable) {
+                return bucketMobPickup(player, itemStack, hand, pickupEntity, bucketable);
+            }
+            return Optional.empty();
+        }
+        for (Bucketable bucketable : bucketables) {
+            Optional<InteractionResult> result = bucketMobPickup(player, itemStack, hand, pickupEntity, bucketable);
+            if (result.isPresent()) {
+                return result;
+            }
+        }
+        return Optional.empty();
+    }
+
+    static <T extends LivingEntity> Optional<InteractionResult> bucketMobPickup(Player player, ItemStack itemStack, InteractionHand hand, T pickupEntity, Bucketable bucketable) {
+        // Kiterino end - Extra bucketable mobs
+        if (itemStack.getItem() == bucketable.getPickBucket() && pickupEntity.isAlive() && bucketable.canPickup(pickupEntity)) { // Kiterino - Extra bucketable mobs
             // CraftBukkit start
             // pickupEntity.playSound(pickupEntity.getPickupSound(), 1.0F, 1.0F); // CraftBukkit - moved down
-            ItemStack bucket = pickupEntity.getBucketItemStack();
-            pickupEntity.saveToBucketTag(bucket);
+            ItemStack bucket = bucketable.getBucketItemStack(); // Kiterino - Extra bucketable mobs
+            bucketable.saveToBucketTag(pickupEntity, bucket); // Kiterino - Extra bucketable mobs
             org.bukkit.event.player.PlayerBucketEntityEvent playerBucketFishEvent = org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerFishBucketEvent(pickupEntity, player, itemStack, bucket, hand);
             bucket = org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(playerBucketFishEvent.getEntityBucket());
             if (playerBucketFishEvent.isCancelled()) {
@@ -97,7 +134,7 @@ public interface Bucketable {
                 pickupEntity.resendPossiblyDesyncedEntityData((ServerPlayer) player); // Paper
                 return Optional.of(InteractionResult.FAIL);
             }
-            pickupEntity.playSound(pickupEntity.getPickupSound(), 1.0F, 1.0F);
+            pickupEntity.playSound(bucketable.getPickupSound(), 1.0F, 1.0F); // Kiterino - Extra bucketable mobs
             // CraftBukkit end
             ItemStack result = ItemUtils.createFilledResult(itemStack, player, bucket, false);
             player.setItemInHand(hand, result);
