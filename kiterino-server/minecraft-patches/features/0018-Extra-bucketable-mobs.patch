+++ b/net/minecraft/world/item/BucketItem.java
@@ -64,11 +64,12 @@ public class BucketItem extends Item implements DispensibleContainerItem {
                     CriteriaTriggers.PLACED_BLOCK.trigger(serverPlayer, placePos, itemStack);
                 }
 
+                player.swing(hand, true); // Kiterino - Extra bucketable mobs
                 player.awardStat(Stats.ITEM_USED.get(this));
                 ItemStack emptyResult = ItemUtils.createFilledResult(itemStack, player, getEmptySuccessItem(itemStack, player));
                 return InteractionResult.SUCCESS.heldItemTransformedTo(emptyResult);
             } else {
-                if (this.content == Fluids.EMPTY) {
+                if (this.content == Fluids.EMPTY && !(this instanceof MobBucketItem)) { // Kiterino - Extra bucketable mobs
                     BlockState blockState = level.getBlockState(pos);
                     if (blockState.getBlock() instanceof BucketPickup bucketPickupBlock) {
                         // CraftBukkit start
@@ -130,7 +131,7 @@ public class BucketItem extends Item implements DispensibleContainerItem {
 
     public boolean emptyContents(final @Nullable LivingEntity user, final Level level, final BlockPos pos, final @Nullable BlockHitResult hitResult, final Direction direction, final BlockPos clicked, final ItemStack itemStack, final InteractionHand hand) {
         // CraftBukkit end
-        if (!(this.content instanceof FlowingFluid flowingFluid)) {
+        if (!(this.content instanceof FlowingFluid flowingFluid) && !(this instanceof MobBucketItem && this.content == Fluids.EMPTY)) { // Kiterino - Extra bucketable mobs
             return false;
         } else {
             BlockState blockState = level.getBlockState(pos);
@@ -166,16 +167,16 @@ public class BucketItem extends Item implements DispensibleContainerItem {
                 }
 
                 return true;
-            } else if (block instanceof LiquidBlockContainer container && this.content == Fluids.WATER) {
+            } else if (block instanceof LiquidBlockContainer container && this.content == Fluids.WATER && this.content instanceof FlowingFluid flowingFluid) { // Kiterino - Extra bucketable mobs
                 container.placeLiquid(level, pos, blockState, flowingFluid.getSource(false));
                 this.playEmptySound(user, level, pos);
                 return true;
             } else {
-                if (!level.isClientSide() && mayReplace && !blockState.liquid()) {
+                if (!(this instanceof MobBucketItem && this.content == Fluids.EMPTY) && !level.isClientSide() && mayReplace && !blockState.liquid()) { // Kiterino - Extra bucketable mobs
                     level.destroyBlock(pos, true);
                 }
 
-                if (!level.setBlock(pos, this.content.defaultFluidState().createLegacyBlock(), Block.UPDATE_ALL_IMMEDIATE)
+                if (!(this instanceof MobBucketItem && this.content == Fluids.EMPTY) && !level.setBlock(pos, this.content.defaultFluidState().createLegacyBlock(), Block.UPDATE_ALL_IMMEDIATE) // Kiterino - Extra bucketable mobs
                     && !blockState.getFluidState().isSource()) {
                     return false;
                 }
diff --git a/net/minecraft/world/item/MobBucketItem.java b/net/minecraft/world/item/MobBucketItem.java
index 73ebbb4e5403db903a9153a7852b3bfcea118fc0..aa1ed1b723f6adabf3d796a7120ea218a99f6069 100644
--- a/net/minecraft/world/item/MobBucketItem.java
+++ b/net/minecraft/world/item/MobBucketItem.java
@@ -21,6 +21,14 @@ import net.minecraft.world.phys.BlockHitResult;
 import org.jspecify.annotations.Nullable;
 
 public class MobBucketItem extends BucketItem {
+    // Kiterino start - Extra bucketable mobs
+    public static net.minecraft.core.dispenser.DispenseItemBehavior BUCKET_DISPENSE_BEHAVIOR;
+    public static final java.util.Map<EntityType<? extends Mob>, java.util.List<Bucketable>> EXTRA_BUCKETABLE_RULES = new java.util.HashMap<>();
+    public MobBucketItem bucketable(Bucketable bucketable) {
+        EXTRA_BUCKETABLE_RULES.computeIfAbsent(this.type, k -> new java.util.ArrayList<>()).add(bucketable);
+        return this;
+    }
+    // Kiterino end - Extra bucketable mobs
     private final EntityType<? extends Mob> type;
     private final SoundEvent emptySound;
 
@@ -45,9 +53,30 @@ public class MobBucketItem extends BucketItem {
 
     private void spawn(final ServerLevel level, final ItemStack itemStack, final BlockPos spawnPos) {
         Mob mob = this.type.create(level, EntityType.createDefaultStackConfig(level, itemStack, null), spawnPos, EntitySpawnReason.BUCKET, true, false);
-        if (mob instanceof Bucketable bucketable) {
+        // Kiterino start - Extra bucketable mobs
+        Bucketable bucketable = null;
+        java.util.List<Bucketable> bucketables = EXTRA_BUCKETABLE_RULES.get(this.type);
+        if (bucketables != null) {
+            for (Bucketable b : bucketables) {
+                if (b.getBucketItemStack().is(itemStack.getItem())) {
+                    bucketable = b;
+                    break;
+                }
+            }
+        }
+        if (bucketable == null && mob instanceof Bucketable b) {
+            bucketable = b;
+        }
+        if (bucketable != null) {
+            // Kiterino end - Extra bucketable mobs
             CustomData entityData = itemStack.getOrDefault(DataComponents.BUCKET_ENTITY_DATA, CustomData.EMPTY);
-            bucketable.loadFromBucketTag(entityData.copyTag());
+            // Kiterino start - Extra bucketable mobs
+            if (mob == null) {
+                bucketable.loadFromBucketTag(entityData.copyTag());
+            } else {
+                bucketable.loadFromBucketTag(mob, entityData.copyTag());
+            }
+            // Kiterino end - Extra bucketable mobs
             bucketable.setFromBucket(true);
         }
 
