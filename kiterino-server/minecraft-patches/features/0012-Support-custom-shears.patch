     @Override
     public InteractionResult mobInteract(Player player, InteractionHand hand) {
         ItemStack itemInHand = player.getItemInHand(hand);
-        if (itemInHand.is(Items.SHEARS)) {
+        if (itemInHand.getItem() instanceof net.minecraft.world.item.ShearsItem) { // Kiterino - Support custom shears
             if (this.level() instanceof ServerLevel serverLevel && this.readyForShearing()) {
                 // CraftBukkit start
                 // Paper start - custom shear drops
diff --git a/net/minecraft/world/entity/animal/wolf/Wolf.java b/net/minecraft/world/entity/animal/wolf/Wolf.java
index 936ee9e80239ad965be75ceeb38d5248243e9c4e..68cd097e86a52f8202a800fe6d628884bf4a230c 100644
--- a/net/minecraft/world/entity/animal/wolf/Wolf.java
+++ b/net/minecraft/world/entity/animal/wolf/Wolf.java
@@ -606,7 +606,7 @@ public class Wolf extends TamableAnimal implements NeutralMob {
                     return InteractionResult.SUCCESS;
                 }
 
-                if (!itemInHand.is(Items.SHEARS)
+                if (!(itemInHand.getItem() instanceof net.minecraft.world.item.ShearsItem) // Kiterino - Support custom shears
                     || !this.isOwnedBy(player)
                     || !this.isWearingBodyArmor()
                     || EnchantmentHelper.has(this.getBodyArmorItem(), EnchantmentEffectComponents.PREVENT_ARMOR_CHANGE) && !player.isCreative()) {
diff --git a/net/minecraft/world/entity/monster/Bogged.java b/net/minecraft/world/entity/monster/Bogged.java
index bc8f46b656895d916e44a9e1dc9175da96c2fde8..5a5dcee040d469091c708d3ebb6801ee19e1eeee 100644
