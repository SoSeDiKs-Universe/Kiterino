diff --git a/net/minecraft/world/entity/decoration/LeashFenceKnotEntity.java b/net/minecraft/world/entity/decoration/LeashFenceKnotEntity.java
index a131b98a9f9e212bd55645a0e048da8fafbbb3d9..bc385afbee82dc24b044452ee25903ce830d1ae5 100644
--- a/net/minecraft/world/entity/decoration/LeashFenceKnotEntity.java
+++ b/net/minecraft/world/entity/decoration/LeashFenceKnotEntity.java
@@ -72,7 +72,7 @@ public class LeashFenceKnotEntity extends BlockAttachedEntity {
         if (this.level().isClientSide) {
             return InteractionResult.SUCCESS;
         } else {
-            if (player.getItemInHand(hand).is(Items.SHEARS)) {
+            if (player.getItemInHand(hand).getItem() instanceof net.minecraft.world.item.ShearsItem) { // Kiterino - Support custom shears
                 InteractionResult interactionResult = super.interact(player, hand);
                 if (interactionResult instanceof InteractionResult.Success success && success.wasItemInteraction()) {
                     return interactionResult;
diff --git a/net/minecraft/world/entity/monster/Bogged.java b/net/minecraft/world/entity/monster/Bogged.java
