From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Sun, 27 Apr 2025 12:45:30 +0300
Subject: [PATCH] Add EntityItemConsumeEvent


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 21880d0414201a9a4c109ab24bcc10d679916680..195bc559c9a400744c9cef0f36a6afed82c1f51a 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4556,12 +4556,12 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                     this.startUsingItem(this.getUsedItemHand(), true); // Paper - Prevent consuming the wrong itemstack
                     // CraftBukkit start - fire PlayerItemConsumeEvent
                     ItemStack result;
-                    org.bukkit.event.player.PlayerItemConsumeEvent event = null; // Paper
+                    me.sosedik.kiterino.event.entity.ItemConsumeEvent event = null; // Paper // Kiterino - Add EntityItemConsumeEvent
                     if (this instanceof ServerPlayer serverPlayer) {
                         org.bukkit.inventory.ItemStack craftItem = CraftItemStack.asBukkitCopy(this.useItem);
                         org.bukkit.inventory.EquipmentSlot handSlot = org.bukkit.craftbukkit.CraftEquipmentSlot.getHand(hand);
                         event = new org.bukkit.event.player.PlayerItemConsumeEvent((org.bukkit.entity.Player)this.getBukkitEntity(), craftItem, handSlot); // Paper
-                        this.level().getCraftServer().getPluginManager().callEvent(event);
+                        event.callEvent(); // Kiterino - Add EntityItemConsumeEvent
 
                         if (event.isCancelled()) {
                             net.minecraft.world.item.component.Consumable consumable = this.useItem.get(DataComponents.CONSUMABLE);
@@ -4582,6 +4582,18 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                     final ItemStack defaultReplacement = result;
                     if (event != null && event.getReplacement() != null) {
                         result = CraftItemStack.asNMSCopy(event.getReplacement());
+                        // Kiterino start - Add EntityItemConsumeEvent
+                        org.bukkit.inventory.ItemStack craftItem = CraftItemStack.asBukkitCopy(this.useItem);
+                        org.bukkit.inventory.EquipmentSlot equipmentSlot = org.bukkit.craftbukkit.CraftEquipmentSlot.getHand(hand);
+                        event = new me.sosedik.kiterino.event.entity.EntityItemConsumeEvent(this.getBukkitLivingEntity(), craftItem, equipmentSlot);
+                        event.callEvent();
+                        if (event.isCancelled()) {
+                            this.stopUsingItem();
+                            return;
+                        }
+
+                        result = (craftItem.equals(event.getItem())) ? this.useItem.finishUsingItem(this.level(), this) : CraftItemStack.asNMSCopy(event.getItem()).finishUsingItem(this.level(), this);
+                        // Kiterino end - Add EntityItemConsumeEvent
                     }
                     // Paper end
                     // CraftBukkit end
