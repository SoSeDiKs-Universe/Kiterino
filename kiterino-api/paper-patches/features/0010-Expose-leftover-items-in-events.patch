From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoSeDiK <mrsosedik@gmail.com>
Date: Tue, 18 Nov 2025 16:27:29 +0200
Subject: [PATCH] Expose leftover items in events


diff --git a/src/main/java/org/bukkit/event/inventory/BrewEvent.java b/src/main/java/org/bukkit/event/inventory/BrewEvent.java
index e67c074c6dea2b6b01046d5f18335941c320e70f..a3de4995f8ef18537902bf2356d6ceb8f1bf82a4 100644
--- a/src/main/java/org/bukkit/event/inventory/BrewEvent.java
+++ b/src/main/java/org/bukkit/event/inventory/BrewEvent.java
@@ -21,6 +21,7 @@ public class BrewEvent extends BlockEvent implements Cancellable {
     private final BrewerInventory contents;
     private final List<ItemStack> results;
     private final int fuelLevel;
+    private @org.jetbrains.annotations.Nullable ItemStack remainingItem; // Kiterino - Expose leftover items in events
 
     private boolean cancelled;
 
@@ -68,6 +69,26 @@ public class BrewEvent extends BlockEvent implements Cancellable {
         return this.fuelLevel;
     }
 
+    // Kiterino start - Expose leftover items in events
+    /**
+     * Gets the remaining item
+     *
+     * @return the remaining item
+     */
+    public @org.jetbrains.annotations.Nullable ItemStack getRemainingItem() {
+        return this.remainingItem == null ? null : this.remainingItem.clone();
+    }
+
+    /**
+     * Sets the remaining item
+     *
+     * @param remainingItem remaining item
+     */
+    public void setRemainingItem(@org.jetbrains.annotations.Nullable ItemStack remainingItem) {
+        this.remainingItem = remainingItem;
+    }
+    // Kiterino end - Expose leftover items in events
+
     @Override
     public boolean isCancelled() {
         return this.cancelled;
diff --git a/src/main/java/org/bukkit/event/inventory/FurnaceBurnEvent.java b/src/main/java/org/bukkit/event/inventory/FurnaceBurnEvent.java
index aacb6ed251adcb5fab00668eebe47e60af270cb5..e3dd00f1f9c3c1b44906267df8655b7bd887e05c 100644
--- a/src/main/java/org/bukkit/event/inventory/FurnaceBurnEvent.java
+++ b/src/main/java/org/bukkit/event/inventory/FurnaceBurnEvent.java
@@ -21,6 +21,7 @@ public class FurnaceBurnEvent extends BlockEvent implements Cancellable {
     private int burnTime;
     private boolean burning = true;
     private boolean consumeFuel = true;
+    private @org.jetbrains.annotations.Nullable ItemStack remainingItem; // Kiterino - Expose leftover items in events
 
     private boolean cancelled;
 
@@ -95,6 +96,26 @@ public class FurnaceBurnEvent extends BlockEvent implements Cancellable {
         this.consumeFuel = consumeFuel;
     }
 
+    // Kiterino start - Expose leftover items in events
+    /**
+     * Gets the remaining item
+     *
+     * @return the remaining item
+     */
+    public @org.jetbrains.annotations.Nullable ItemStack getRemainingItem() {
+        return this.remainingItem == null ? null : this.remainingItem.clone();
+    }
+
+    /**
+     * Sets the remaining item
+     *
+     * @param remainingItem remaining item
+     */
+    public void setRemainingItem(@org.jetbrains.annotations.Nullable ItemStack remainingItem) {
+        this.remainingItem = remainingItem;
+    }
+    // Kiterino end - Expose leftover items in events
+
     @Override
     public boolean isCancelled() {
         return this.cancelled;
