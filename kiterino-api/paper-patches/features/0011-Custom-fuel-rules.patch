Subject: [PATCH] Custom fuel rules


diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index a6d62a0c92b6788ce5575368eb33c11622661861..0a3f4187acb7a23add50c6bee79e2487eea3a7e6 100644
--- a/src/main/java/org/bukkit/Bukkit.java
+++ b/src/main/java/org/bukkit/Bukkit.java
@@ -3047,6 +3047,17 @@ public final class Bukkit {
     }
     // Purpur end - Added the ability to add combustible items
 
+    // Kiterino start - Custom fuel rules
+    /**
+     * Add an extra fuel rule
+     *
+     * @param rule burning rule
+     */
+    public static void addFuel(@NotNull java.util.function.Function<ItemStack, Integer> rule) {
+        server.addFuel(rule);
+    }
+    // Kiterino end - Custom fuel rules
+
     // Purpur start - Debug Marker API
     /**
      * Creates debug block highlight on specified block location and show it to all players on the server.
